generator client {
  provider        = "prisma-client"
  output          = "../lib/generated/prisma"
  // Partial unique indexes enforce "one current academic year" and "one
  // active enrollment per year" in the database, not only in code.
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

enum OrganizationType {
  SCHOOL
  COLLEGE
  UNIVERSITY
  INSTITUTE
  OTHER
}

// Application-level profile for a Supabase Auth user. Credentials live in
// Supabase (auth.users); this table never stores passwords.
model User {
  id         String   @id @default(uuid()) @db.Uuid
  authUserId String   @unique @map("auth_user_id") @db.Uuid
  email      String   @unique
  name       String?
  avatarUrl  String?  @map("avatar_url")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  memberships                   OrganizationMember[]
  platformAdmin                 PlatformAdmin?
  // Optional portal links: a student or guardian record can be tied to the
  // account that signs in for it (unique per organisation on those models).
  studentProfiles               Student[]
  guardianProfiles              Guardian[]
  teacherProfiles               Teacher[]
  staffProfiles                 Staff[]
  auditLogs                     AuditLog[]
  attendanceSessionsTaken       AttendanceSession[]    @relation("AttendanceSessionTakenBy")
  studentAttendanceMarked       StudentAttendance[]    @relation("StudentAttendanceMarkedBy")
  employeeAttendanceMarked      EmployeeAttendance[]   @relation("EmployeeAttendanceMarkedBy")
  attendanceCorrectionsAsked    AttendanceCorrection[] @relation("AttendanceCorrectionRequestedBy")
  attendanceCorrectionsReviewed AttendanceCorrection[] @relation("AttendanceCorrectionReviewedBy")

  @@map("users")
}

// Platform (SaaS operator) access, kept separate from organisation roles:
// no organisation role can ever grant it.
model PlatformAdmin {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @unique @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("platform_admins")
}

// A tenant: a school, college, university or institute.
model Organization {
  id        String           @id @default(uuid()) @db.Uuid
  name      String
  slug      String           @unique
  type      OrganizationType
  country   String?
  logoUrl   String?          @map("logo_url")
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")

  roles   Role[]
  members OrganizationMember[]

  // Education structure (configured per organisation).
  faculties            Faculty[]
  educationLevels      EducationLevel[]
  programs             Program[]
  academicClasses      AcademicClass[]
  sections             Section[]
  batches              Batch[]
  academicYears        AcademicYear[]
  documentRequirements DocumentRequirement[]
  studentSettings      StudentSettings?
  subjects             Subject[]
  subjectCategories    SubjectCategory[]
  subjectPrerequisites SubjectPrerequisite[]
  curricula            Curriculum[]
  curriculumUnits      CurriculumUnit[]
  curriculumTopics     CurriculumTopic[]
  electiveGroups       ElectiveGroup[]
  subjectOfferings     SubjectOffering[]
  offeringSections     SubjectOfferingSection[]
  designations         Designation[]
  staffSettings        StaffSettings?

  // Students.
  students             Student[]
  guardians            Guardian[]
  studentGuardians     StudentGuardian[]
  guardianInvitations  GuardianInvitation[]
  enrollments          Enrollment[]
  studentDocuments     StudentDocument[]
  studentStatusHistory StudentStatusHistory[]

  // Teachers.
  teachers                 Teacher[]
  teacherEmploymentRecords TeacherEmploymentRecord[]
  teacherQualifications    TeacherQualification[]
  teacherCertifications    TeacherCertification[]
  teacherDocuments         TeacherDocument[]
  teacherAssignments       TeacherAssignment[]

  // Non-teaching staff.
  departments            Department[]
  staff                  Staff[]
  staffEmploymentRecords StaffEmploymentRecord[]
  staffQualifications    StaffQualification[]
  staffDocuments         StaffDocument[]
  staffAssignments       StaffAssignment[]

  // Attendance.
  attendancePolicy      AttendancePolicy?
  holidays              Holiday[]
  attendanceSessions    AttendanceSession[]
  studentAttendance     StudentAttendance[]
  employeeAttendance    EmployeeAttendance[]
  attendanceCorrections AttendanceCorrection[]
  attendanceAlerts      AttendanceAlert[]

  // Examinations, grading and results.
  assessmentTypes       AssessmentType[]
  gradingScales         GradingScale[]
  gradingScaleRules     GradingScaleRule[]
  resultPolicies        ResultPolicy[]
  examinations          Examination[]
  examinationSubjects   ExaminationSubject[]
  assessmentComponents  AssessmentComponent[]
  marksSheets           MarksSheet[]
  studentMarks          StudentMark[]
  studentMarkHistory    StudentMarkHistory[]
  markRemarks           MarkRemark[]
  resultHolds           ResultHold[]
  resultPublications    ResultPublication[]
  studentResults        StudentResult[]
  studentSubjectResults StudentSubjectResult[]

  auditLogs AuditLog[]

  @@map("organizations")
}

// Roles are per organisation, so the same person can hold different roles
// in different organisations, and organisations can define custom roles.
model Role {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String
  slug           String
  description    String?
  // Default roles created with the organisation (owner, admin, ...).
  isSystem       Boolean  @default(false) @map("is_system")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  permissions  RolePermission[]
  members      OrganizationMember[]

  @@unique([organizationId, slug])
  // Lets memberships reference (role, organisation) together, so a member
  // can never be given a role that belongs to a different organisation.
  @@unique([id, organizationId])
  @@map("roles")
}

// Global catalogue of granular permissions, e.g. "students.create".
model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String   @map("role_id") @db.Uuid
  permissionId String   @map("permission_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model OrganizationMember {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  roleId         String   @map("role_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  // Composite key: the role must belong to this same organisation.
  role         Role         @relation(fields: [roleId, organizationId], references: [id, organizationId], onDelete: NoAction)

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@index([roleId, organizationId])
  @@map("organization_members")
}

// =============================================================== education
//
// Every organisation configures its own structure; nothing here is hardcoded
// for a particular kind of institution. All organisation-owned tables carry
// organization_id, and child records reference their parents through
// composite (id, organization_id) keys, so the database itself refuses a
// program, class or enrollment that points into another organisation.

// How an organisation's classes are named and ordered within a level.
enum GroupingKind {
  GRADE
  SEMESTER
  YEAR
  LEVEL
  COHORT
  OTHER
}

enum AcademicYearStatus {
  PLANNED
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum NumberingMode {
  MANUAL
  AUTOMATIC
}

// Many Nepali schools and colleges run separate morning and day shifts.
enum SectionShift {
  MORNING
  DAY
  EVENING
}

// Medium of instruction of a section (English, Nepali or mother tongue).
enum InstructionMedium {
  ENGLISH
  NEPALI
  BILINGUAL
  MOTHER_TONGUE
  OTHER
}

// Optional: Faculty of Management, Department of Science, ...
model Faculty {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String
  code           String
  description    String?
  isActive       Boolean  @default(true) @map("is_active")
  sortOrder      Int      @default(0) @map("sort_order")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  programs     Program[]
  // Also used as the teacher's department.
  teachers     Teacher[]

  @@unique([organizationId, code])
  @@unique([id, organizationId])
  @@map("faculties")
}

// ECD, Basic, Secondary, +2, Bachelor's, ... (presets are only a starting point).
model EducationLevel {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  name           String
  code           String
  // Which preset this was created from, if any (see education presets).
  presetKey      String?      @map("preset_key")
  description    String?
  groupingKind   GroupingKind @default(GRADE) @map("grouping_kind")
  // Levels such as +2 or Bachelor's place students in a program; schools don't.
  usesPrograms   Boolean      @default(false) @map("uses_programs")
  isActive       Boolean      @default(true) @map("is_active")
  sortOrder      Int          @default(0) @map("sort_order")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  organization         Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  programs             Program[]
  classes              AcademicClass[]
  enrollments          Enrollment[]
  documentRequirements DocumentRequirement[]
  subjects             Subject[]
  curricula            Curriculum[]
  teacherAssignments   TeacherAssignment[]
  holidays             Holiday[]
  examinations         Examination[]
  resultPolicies       ResultPolicy[]

  @@unique([organizationId, code])
  @@unique([id, organizationId])
  @@index([organizationId, sortOrder])
  @@map("education_levels")
}

// Science, Management, BBS, BCA, Diploma in Computer Engineering, ...
model Program {
  id               String   @id @default(uuid()) @db.Uuid
  organizationId   String   @map("organization_id") @db.Uuid
  educationLevelId String   @map("education_level_id") @db.Uuid
  facultyId        String?  @map("faculty_id") @db.Uuid
  name             String
  code             String
  description      String?
  // Length in the level's grouping unit (e.g. 8 semesters, 4 years).
  duration         Int?
  isActive         Boolean  @default(true) @map("is_active")
  sortOrder        Int      @default(0) @map("sort_order")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  educationLevel     EducationLevel      @relation(fields: [educationLevelId, organizationId], references: [id, organizationId], onDelete: NoAction)
  faculty            Faculty?            @relation(fields: [facultyId, organizationId], references: [id, organizationId], onDelete: NoAction)
  classes            AcademicClass[]
  batches            Batch[]
  enrollments        Enrollment[]
  subjects           Subject[]
  curricula          Curriculum[]
  teacherAssignments TeacherAssignment[]
  examinations       Examination[]

  @@unique([organizationId, code])
  @@unique([id, organizationId])
  @@index([organizationId, educationLevelId])
  @@map("programs")
}

// Grade 1, Grade 11, Semester 3, Year 2, ... A class belongs to a level and,
// for levels that use programs, to one program.
model AcademicClass {
  id               String       @id @default(uuid()) @db.Uuid
  organizationId   String       @map("organization_id") @db.Uuid
  educationLevelId String       @map("education_level_id") @db.Uuid
  programId        String?      @map("program_id") @db.Uuid
  name             String
  // Optional name in Nepali (e.g. "कक्षा ५") for registers and report cards.
  localName        String?      @map("local_name")
  // Optional short code, unique within the organisation (e.g. G8, BBS-Y1).
  code             String?
  description      String?
  kind             GroupingKind @default(GRADE)
  // Position within the level/program; drives "promote to next class".
  sequence         Int          @default(1)
  // Maximum students in the whole class (each section has its own capacity).
  capacity         Int?
  // Inactive classes take no new placements; archived ones are also hidden
  // from day-to-day lists. Both keep every historical enrollment.
  isActive         Boolean      @default(true) @map("is_active")
  archivedAt       DateTime?    @map("archived_at")
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")

  organization        Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  educationLevel      EducationLevel       @relation(fields: [educationLevelId, organizationId], references: [id, organizationId], onDelete: NoAction)
  program             Program?             @relation(fields: [programId, organizationId], references: [id, organizationId], onDelete: NoAction)
  sections            Section[]
  enrollments         Enrollment[]
  teacherAssignments  TeacherAssignment[]
  subjectOfferings    SubjectOffering[]
  electiveGroups      ElectiveGroup[]
  attendanceSessions  AttendanceSession[]
  examinationSubjects ExaminationSubject[]

  @@unique([id, organizationId])
  // Class names are unique within their level (no program) or program.
  @@unique([educationLevelId, name], map: "academic_classes_level_name_key", where: raw("program_id IS NULL"))
  @@unique([programId, name], map: "academic_classes_program_name_key", where: raw("program_id IS NOT NULL"))
  @@unique([organizationId, code], map: "academic_classes_code_key", where: raw("code IS NOT NULL"))
  @@index([organizationId, educationLevelId, programId, sequence])
  @@map("academic_classes")
}

// A, B, क, ख, Morning, ... within one class.
model Section {
  id             String             @id @default(uuid()) @db.Uuid
  organizationId String             @map("organization_id") @db.Uuid
  classId        String             @map("class_id") @db.Uuid
  name           String
  code           String?
  description    String?
  capacity       Int?
  shift          SectionShift?
  medium         InstructionMedium?
  room           String?
  isActive       Boolean            @default(true) @map("is_active")
  sortOrder      Int                @default(0) @map("sort_order")
  archivedAt     DateTime?          @map("archived_at")
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")

  organization       Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  class              AcademicClass            @relation(fields: [classId, organizationId], references: [id, organizationId], onDelete: NoAction)
  enrollments        Enrollment[]
  teacherAssignments TeacherAssignment[]
  subjectOfferings   SubjectOfferingSection[]
  attendanceSessions AttendanceSession[]
  marksSheets        MarksSheet[]

  @@unique([classId, name])
  @@unique([id, organizationId])
  // Lets an enrollment reference (section, class) together, so its section
  // always belongs to its class.
  @@unique([id, classId])
  @@map("sections")
}

// Optional intake groups such as "Batch 2026".
model Batch {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  programId      String?  @map("program_id") @db.Uuid
  name           String
  startYear      Int?     @map("start_year")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  program            Program?            @relation(fields: [programId, organizationId], references: [id, organizationId], onDelete: NoAction)
  enrollments        Enrollment[]
  teacherAssignments TeacherAssignment[]
  subjectOfferings   SubjectOffering[]
  electiveGroups     ElectiveGroup[]

  @@unique([organizationId, name])
  @@unique([id, organizationId])
  @@map("batches")
}

model AcademicYear {
  id             String             @id @default(uuid()) @db.Uuid
  organizationId String             @map("organization_id") @db.Uuid
  // Free text so organisations can use BS ("2082/83"), AD or both.
  name           String
  startDate      DateTime           @map("start_date") @db.Date
  endDate        DateTime           @map("end_date") @db.Date
  status         AcademicYearStatus @default(PLANNED)
  // The year new admissions and the students list default to.
  isCurrent      Boolean            @default(false) @map("is_current")
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")

  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  enrollments        Enrollment[]
  teacherAssignments TeacherAssignment[]
  electiveGroups     ElectiveGroup[]
  subjectOfferings   SubjectOffering[]
  attendanceSessions AttendanceSession[]
  examinations       Examination[]

  @@unique([organizationId, name])
  @@unique([id, organizationId])
  @@unique([organizationId], map: "academic_years_one_current_key", where: raw("is_current"))
  @@map("academic_years")
}

enum DocumentAudience {
  STUDENT
  TEACHER
  STAFF
}

// Documents an organisation asks students (or teachers) to submit.
model DocumentRequirement {
  id               String           @id @default(uuid()) @db.Uuid
  organizationId   String           @map("organization_id") @db.Uuid
  // Who submits it. Existing rows are student requirements.
  audience         DocumentAudience @default(STUDENT)
  // Null: applies to every student (always null for teacher documents).
  educationLevelId String?          @map("education_level_id") @db.Uuid
  name             String
  description      String?
  isRequired       Boolean          @default(true) @map("is_required")
  isActive         Boolean          @default(true) @map("is_active")
  sortOrder        Int              @default(0) @map("sort_order")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  educationLevel   EducationLevel?   @relation(fields: [educationLevelId, organizationId], references: [id, organizationId], onDelete: NoAction)
  documents        StudentDocument[]
  teacherDocuments TeacherDocument[]
  staffDocuments   StaffDocument[]

  @@unique([organizationId, audience, name])
  @@unique([id, organizationId])
  @@map("document_requirements")
}

// Per-organisation admission (and guardian ID) numbering rules.
model StudentSettings {
  organizationId         String        @id @map("organization_id") @db.Uuid
  admissionNumberMode    NumberingMode @default(AUTOMATIC) @map("admission_number_mode")
  admissionNumberPrefix  String        @default("ADM-") @map("admission_number_prefix")
  admissionNumberPadding Int           @default(5) @map("admission_number_padding")
  // Next value to hand out; incremented atomically (UPDATE ... RETURNING).
  nextAdmissionSequence  Int           @default(1) @map("next_admission_sequence")
  rollNumberMode         NumberingMode @default(AUTOMATIC) @map("roll_number_mode")
  // Refuse placements beyond a section's (or sectionless class's) capacity.
  enforceSectionCapacity Boolean       @default(false) @map("enforce_section_capacity")
  // Guardian IDs share the padding above; numbers taken by hand are skipped.
  guardianCodePrefix     String        @default("GRD-") @map("guardian_code_prefix")
  nextGuardianSequence   Int           @default(1) @map("next_guardian_sequence")
  updatedAt              DateTime      @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("student_settings")
}

// ================================================================ students

enum Gender {
  MALE
  FEMALE
  OTHER
}

// Lifecycle of the person at this institution. Archiving is separate
// (archived_at): it hides a record without changing what happened.
enum StudentStatus {
  ACTIVE
  SUSPENDED
  WITHDRAWN
  TRANSFERRED
  GRADUATED
}

// Nepal's constitutional inclusion groups, as used for UGC/EMIS reporting.
enum CasteEthnicity {
  DALIT
  ADIVASI_JANAJATI
  MADHESI
  MUSLIM
  THARU
  KHAS_ARYA
  OTHER
}

// Disability Rights Act 2074 categories; NONE = recorded as no disability.
enum DisabilityType {
  NONE
  PHYSICAL
  VISUAL
  HEARING
  DEAF_BLIND
  SPEECH
  INTELLECTUAL
  PSYCHOSOCIAL
  AUTISM
  HAEMOPHILIA
  MULTIPLE
  OTHER
}

// Scholarship a student was admitted on (EMIS 7.1); NONE = no scholarship.
enum ScholarshipCategory {
  NONE
  UGC
  UNIVERSITY
  COLLEGE
  MERIT
  NEED_BASED
  DALIT
  DISABILITY
  OTHER
}

enum AdmissionType {
  NEW
  TRANSFER
  READMISSION
  LATERAL_ENTRY
}

enum AddressType {
  PERMANENT
  TEMPORARY
}

enum GuardianRelationship {
  FATHER
  MOTHER
  GRANDFATHER
  GRANDMOTHER
  BROTHER
  SISTER
  UNCLE
  AUNT
  SPOUSE
  LEGAL_GUARDIAN
  OTHER
}

enum EnrollmentType {
  NEW_ADMISSION
  PROMOTION
  REPEAT
  TRANSFER
  READMISSION
  LATERAL_ENTRY
}

// ACTIVE/ON_HOLD are open placements; everything else is closed history.
enum EnrollmentStatus {
  ACTIVE
  ON_HOLD
  PROMOTED
  COMPLETED
  DETAINED
  TRANSFERRED
  WITHDRAWN
  CANCELLED
}

enum StudentHistoryAction {
  CREATED
  STATUS_CHANGED
  ARCHIVED
  RESTORED
}

// A student's persistent identity. Academic placement lives in Enrollment.
model Student {
  id                        String               @id @default(uuid()) @db.Uuid
  organizationId            String               @map("organization_id") @db.Uuid
  admissionNumber           String               @map("admission_number")
  firstName                 String               @map("first_name")
  middleName                String?              @map("middle_name")
  lastName                  String               @map("last_name")
  dateOfBirth               DateTime?            @map("date_of_birth") @db.Date
  gender                    Gender?
  nationality               String?
  // Path in the private storage bucket, never a public URL.
  profileImagePath          String?              @map("profile_image_path")
  email                     String?
  phone                     String?
  alternatePhone            String?              @map("alternate_phone")
  bloodGroup                String?              @map("blood_group")
  motherTongue              String?              @map("mother_tongue")
  // Restricted: only roles with students.sensitive.view can read it.
  medicalNotes              String?              @map("medical_notes")
  previousSchool            String?              @map("previous_school")
  // UGC/EMIS background. Null = not recorded (never assumed). Disability is
  // restricted like medical notes (students.sensitive.view); NONE records
  // that the student has none.
  casteEthnicity            CasteEthnicity?      @map("caste_ethnicity")
  disabilityType            DisabilityType?      @map("disability_type")
  economicallyDisadvantaged Boolean?             @map("economically_disadvantaged")
  firstGenerationLearner    Boolean?             @map("first_generation_learner")
  remoteArea                Boolean?             @map("remote_area")
  // Admission details.
  scholarshipCategory       ScholarshipCategory? @map("scholarship_category")
  previousQualification     QualificationLevel?  @map("previous_qualification")
  previousResult            String?              @map("previous_result")
  entranceScore             Decimal?             @map("entrance_score") @db.Decimal(6, 2)
  admissionDate             DateTime             @map("admission_date") @db.Date
  admissionType             AdmissionType        @default(NEW) @map("admission_type")
  status                    StudentStatus        @default(ACTIVE)
  // Portal account for this student, if any.
  userId                    String?              @map("user_id") @db.Uuid
  archivedAt                DateTime?            @map("archived_at")
  archivedById              String?              @map("archived_by_id") @db.Uuid
  createdById               String?              @map("created_by_id") @db.Uuid
  createdAt                 DateTime             @default(now()) @map("created_at")
  updatedAt                 DateTime             @updatedAt @map("updated_at")

  organization     Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user             User?                  @relation(fields: [userId], references: [id], onDelete: SetNull)
  addresses        StudentAddress[]
  guardians        StudentGuardian[]
  enrollments      Enrollment[]
  documents        StudentDocument[]
  statusHistory    StudentStatusHistory[]
  attendance       StudentAttendance[]
  attendanceAlerts AttendanceAlert[]
  marks            StudentMark[]
  markRemarks      MarkRemark[]
  resultHolds      ResultHold[]
  results          StudentResult[]

  @@unique([organizationId, admissionNumber])
  @@unique([id, organizationId])
  @@unique([organizationId, userId])
  @@index([organizationId, status, archivedAt])
  @@index([organizationId, lastName, firstName])
  @@index([organizationId, admissionDate])
  @@index([organizationId, casteEthnicity])
  @@index([organizationId, createdAt])
  @@map("students")
}

// Nepal address: province (1–7) → district → municipality → ward → tole.
model StudentAddress {
  id           String      @id @default(uuid()) @db.Uuid
  studentId    String      @map("student_id") @db.Uuid
  type         AddressType
  province     Int?
  district     String?
  municipality String?
  wardNumber   Int?        @map("ward_number")
  tole         String?
  street       String?
  postalCode   String?     @map("postal_code")
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, type])
  @@index([province, district])
  @@map("student_addresses")
}

// How a guardian prefers to be reached. Many guardians in Nepal rarely use
// email, so phone, SMS and messaging apps come first.
enum ContactMethod {
  PHONE
  SMS
  VIBER
  WHATSAPP
  EMAIL
  IN_PERSON
}

// Parent-portal access. A guardian profile is never an account by itself:
// NONE -> INVITED (invitation sent) -> ACTIVE (account linked) <-> DISABLED.
enum GuardianPortalStatus {
  NONE
  INVITED
  ACTIVE
  DISABLED
}

// Expiry is not a status: a PENDING invitation past expires_at is expired.
enum GuardianInvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
}

// A parent or guardian. One guardian can be linked to several students and
// one student to several guardians (StudentGuardian). The login account
// (userId) is optional and separate; passwords live only in Supabase Auth.
model Guardian {
  id                     String               @id @default(uuid()) @db.Uuid
  organizationId         String               @map("organization_id") @db.Uuid
  // Institution identifier (GRD-00001), generated unless entered by hand.
  guardianCode           String?              @map("guardian_code")
  fullName               String               @map("full_name")
  gender                 Gender?
  // Restricted (parents.sensitive.view): date of birth and home addresses.
  dateOfBirth            DateTime?            @map("date_of_birth") @db.Date
  phone                  String?
  alternatePhone         String?              @map("alternate_phone")
  email                  String?
  occupation             String?
  workplace              String?
  nationality            String?
  // Path in the private storage bucket, never a public URL.
  profileImagePath       String?              @map("profile_image_path")
  // Free-text address from quick entry (admission form); the structured
  // address lives in GuardianAddress.
  address                String?
  preferredLanguage      String?              @map("preferred_language")
  preferredContactMethod ContactMethod?       @map("preferred_contact_method")
  portalStatus           GuardianPortalStatus @default(NONE) @map("portal_status")
  userId                 String?              @map("user_id") @db.Uuid
  archivedAt             DateTime?            @map("archived_at")
  archivedById           String?              @map("archived_by_id") @db.Uuid
  createdById            String?              @map("created_by_id") @db.Uuid
  createdAt              DateTime             @default(now()) @map("created_at")
  updatedAt              DateTime             @updatedAt @map("updated_at")

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  students     StudentGuardian[]
  addresses    GuardianAddress[]
  invitations  GuardianInvitation[]

  @@unique([id, organizationId])
  @@unique([organizationId, userId])
  @@unique([organizationId, guardianCode])
  @@index([organizationId, phone])
  @@index([organizationId, fullName])
  @@index([organizationId, archivedAt])
  @@index([organizationId, portalStatus])
  @@index([organizationId, createdAt])
  @@map("guardians")
}

// Nepal address: province (1-7) -> district -> municipality -> ward -> tole.
model GuardianAddress {
  id           String      @id @default(uuid()) @db.Uuid
  guardianId   String      @map("guardian_id") @db.Uuid
  type         AddressType
  province     Int?
  district     String?
  municipality String?
  wardNumber   Int?        @map("ward_number")
  tole         String?
  street       String?
  postalCode   String?     @map("postal_code")
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  guardian Guardian @relation(fields: [guardianId], references: [id], onDelete: Cascade)

  @@unique([guardianId, type])
  @@map("guardian_addresses")
}

// One guardian's relationship to one student, with its own contact roles,
// notification preferences and portal permission. Nothing here is implied by
// the guardian profile alone: portal access to a child needs
// can_access_student_portal_data on this link.
model StudentGuardian {
  studentId                       String               @map("student_id") @db.Uuid
  guardianId                      String               @map("guardian_id") @db.Uuid
  organizationId                  String               @map("organization_id") @db.Uuid
  relationship                    GuardianRelationship
  isPrimary                       Boolean              @default(false) @map("is_primary")
  isEmergencyContact              Boolean              @default(false) @map("is_emergency_contact")
  canPickupStudent                Boolean              @default(false) @map("can_pickup_student")
  receivesAcademicNotifications   Boolean              @default(true) @map("receives_academic_notifications")
  receivesAttendanceNotifications Boolean              @default(true) @map("receives_attendance_notifications")
  // Fee notices; also what lets a guardian see fee details in the portal.
  receivesBillingNotifications    Boolean              @default(false) @map("receives_billing_notifications")
  receivesGeneralAnnouncements    Boolean              @default(true) @map("receives_general_announcements")
  canAccessStudentPortalData      Boolean              @default(false) @map("can_access_student_portal_data")
  notes                           String?
  createdAt                       DateTime             @default(now()) @map("created_at")
  updatedAt                       DateTime             @default(now()) @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  // Both sides share organization_id, so a link can never cross tenants.
  student      Student      @relation(fields: [studentId, organizationId], references: [id, organizationId], onDelete: Cascade)
  guardian     Guardian     @relation(fields: [guardianId, organizationId], references: [id, organizationId], onDelete: NoAction)

  // The composite key also means a guardian is linked to a student at most once.
  @@id([studentId, guardianId])
  @@unique([studentId], map: "student_guardians_one_primary_key", where: raw("is_primary"))
  @@index([guardianId])
  @@index([organizationId])
  @@map("student_guardians")
}

// An invitation for a guardian to link a login account. Only a SHA-256 hash
// of the token is stored; the link is shown once to the person who created
// it. Accepting requires signing in with the invited email address.
model GuardianInvitation {
  id             String                   @id @default(uuid()) @db.Uuid
  organizationId String                   @map("organization_id") @db.Uuid
  guardianId     String                   @map("guardian_id") @db.Uuid
  email          String
  tokenHash      String                   @unique @map("token_hash")
  status         GuardianInvitationStatus @default(PENDING)
  expiresAt      DateTime                 @map("expires_at")
  invitedById    String?                  @map("invited_by_id") @db.Uuid
  acceptedAt     DateTime?                @map("accepted_at")
  acceptedUserId String?                  @map("accepted_user_id") @db.Uuid
  revokedAt      DateTime?                @map("revoked_at")
  revokedById    String?                  @map("revoked_by_id") @db.Uuid
  createdAt      DateTime                 @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  guardian     Guardian     @relation(fields: [guardianId, organizationId], references: [id, organizationId], onDelete: Cascade)

  // At most one open invitation per guardian.
  @@unique([guardianId], map: "guardian_invitations_one_pending_key", where: raw("status = 'PENDING'"))
  @@index([organizationId, status, expiresAt])
  @@map("guardian_invitations")
}

// A student's placement in one academic context. Progressing to another
// class or year closes this row and creates a new one; rows are never
// rewritten into a different placement, so history is preserved.
model Enrollment {
  id                   String           @id @default(uuid()) @db.Uuid
  organizationId       String           @map("organization_id") @db.Uuid
  studentId            String           @map("student_id") @db.Uuid
  academicYearId       String           @map("academic_year_id") @db.Uuid
  // Level and program are copied from the class (server-side) for filtering.
  educationLevelId     String           @map("education_level_id") @db.Uuid
  programId            String?          @map("program_id") @db.Uuid
  classId              String           @map("class_id") @db.Uuid
  sectionId            String?          @map("section_id") @db.Uuid
  batchId              String?          @map("batch_id") @db.Uuid
  rollNumber           String?          @map("roll_number")
  enrollmentDate       DateTime         @map("enrollment_date") @db.Date
  enrollmentType       EnrollmentType   @default(NEW_ADMISSION) @map("enrollment_type")
  status               EnrollmentStatus @default(ACTIVE)
  endedOn              DateTime?        @map("ended_on") @db.Date
  statusReason         String?          @map("status_reason")
  previousEnrollmentId String?          @unique @map("previous_enrollment_id") @db.Uuid
  createdById          String?          @map("created_by_id") @db.Uuid
  createdAt            DateTime         @default(now()) @map("created_at")
  updatedAt            DateTime         @updatedAt @map("updated_at")

  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  student            Student             @relation(fields: [studentId, organizationId], references: [id, organizationId], onDelete: NoAction)
  academicYear       AcademicYear        @relation(fields: [academicYearId, organizationId], references: [id, organizationId], onDelete: NoAction)
  educationLevel     EducationLevel      @relation(fields: [educationLevelId, organizationId], references: [id, organizationId], onDelete: NoAction)
  program            Program?            @relation(fields: [programId, organizationId], references: [id, organizationId], onDelete: NoAction)
  class              AcademicClass       @relation(fields: [classId, organizationId], references: [id, organizationId], onDelete: NoAction)
  section            Section?            @relation(fields: [sectionId, classId], references: [id, classId], onDelete: NoAction)
  batch              Batch?              @relation(fields: [batchId, organizationId], references: [id, organizationId], onDelete: NoAction)
  previousEnrollment Enrollment?         @relation("EnrollmentProgression", fields: [previousEnrollmentId], references: [id], onDelete: SetNull)
  nextEnrollment     Enrollment?         @relation("EnrollmentProgression")
  attendance         StudentAttendance[]
  marks              StudentMark[]
  results            StudentResult[]

  // At most one ACTIVE placement per student per academic year.
  @@unique([studentId, academicYearId], map: "enrollments_one_active_per_year_key", where: raw("status = 'ACTIVE'"))
  // Roll numbers are unique among active placements of a class/section.
  @@unique([academicYearId, classId, sectionId, rollNumber], map: "enrollments_roll_number_key", where: raw("status = 'ACTIVE' AND roll_number IS NOT NULL"))
  // Same rule for classes without sections (NULLs never collide in the index above).
  @@unique([academicYearId, classId, rollNumber], map: "enrollments_roll_number_no_section_key", where: raw("status = 'ACTIVE' AND roll_number IS NOT NULL AND section_id IS NULL"))
  // Lets attendance records reference (enrollment, student) together.
  @@unique([id, studentId])
  @@index([organizationId, academicYearId, status])
  @@index([organizationId, educationLevelId])
  @@index([organizationId, programId])
  @@index([organizationId, classId, sectionId])
  @@index([studentId, enrollmentDate])
  @@map("enrollments")
}

// File metadata; the file itself lives in a private storage bucket.
model StudentDocument {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  studentId      String   @map("student_id") @db.Uuid
  requirementId  String?  @map("requirement_id") @db.Uuid
  title          String
  fileName       String   @map("file_name")
  mimeType       String   @map("mime_type")
  sizeBytes      Int      @map("size_bytes")
  storagePath    String   @unique @map("storage_path")
  uploadedById   String?  @map("uploaded_by_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  student      Student              @relation(fields: [studentId, organizationId], references: [id, organizationId], onDelete: Cascade)
  // Plain FK so deleting a requirement only clears this column (the service
  // checks the requirement belongs to the same organisation).
  requirement  DocumentRequirement? @relation(fields: [requirementId], references: [id], onDelete: SetNull)

  @@index([organizationId, studentId])
  @@index([requirementId])
  @@map("student_documents")
}

model StudentStatusHistory {
  id             String               @id @default(uuid()) @db.Uuid
  organizationId String               @map("organization_id") @db.Uuid
  studentId      String               @map("student_id") @db.Uuid
  action         StudentHistoryAction
  fromStatus     StudentStatus?       @map("from_status")
  toStatus       StudentStatus?       @map("to_status")
  reason         String?
  changedById    String?              @map("changed_by_id") @db.Uuid
  createdAt      DateTime             @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  student      Student      @relation(fields: [studentId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@index([studentId, createdAt])
  @@map("student_status_history")
}

// Append-only record of who changed what, per organisation.
model AuditLog {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  actorUserId    String?  @map("actor_user_id") @db.Uuid
  // e.g. "student.create", "enrollment.promote", "academic_year.set_current"
  action         String
  entityType     String   @map("entity_type")
  entityId       String?  @map("entity_id") @db.Uuid
  summary        String
  metadata       Json?
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor        User?        @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, entityType, entityId])
  @@index([organizationId, createdAt])
  @@map("audit_logs")
}

// ================================================================ teachers
//
// A teacher is an organisation-specific profile, separate from the login
// account (User), which can be linked optionally. Employment, qualifications,
// certifications, documents and teaching assignments are separate records so
// their history is kept. Salary and payroll belong to the finance module and
// are deliberately not stored here.

enum TeacherEmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  TEMPORARY
  VISITING
  OTHER
}

// Academic rank (UGC faculty category), separate from the free-text
// designation. Visiting and part-time are employment types, not ranks.
enum AcademicRank {
  PROFESSOR
  ASSOCIATE_PROFESSOR
  ASSISTANT_PROFESSOR
  LECTURER
  TEACHING_ASSISTANT
  OTHER
}

// Kind of professional development a certification records.
enum DevelopmentType {
  TRAINING
  WORKSHOP
  SEMINAR
  CONFERENCE
  FDP
  CERTIFICATION
  OTHER
}

// Employment lifecycle. Archiving (archived_at) is separate.
enum TeacherEmploymentStatus {
  ACTIVE
  ON_LEAVE
  SUSPENDED
  RESIGNED
  TERMINATED
  RETIRED
  CONTRACT_EXPIRED
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

// Broad tiers only; the exact degree (M.Ed., B.Sc., ...) is free text.
enum QualificationLevel {
  SECONDARY
  HIGHER_SECONDARY
  DIPLOMA
  BACHELOR
  MASTER
  MPHIL
  DOCTORATE
  PROFESSIONAL
  OTHER
}

enum TeacherDocumentCategory {
  CV
  ACADEMIC_CERTIFICATE
  TRAINING_CERTIFICATE
  APPOINTMENT_LETTER
  CONTRACT
  EXPERIENCE_LETTER
  IDENTITY
  OTHER
}

enum TeachingRole {
  SUBJECT_TEACHER
  CLASS_TEACHER
  CO_TEACHER
  OTHER
}

enum AssignmentStatus {
  ACTIVE
  ENDED
  CANCELLED
}

// ============================================================== subjects
//
// A subject (or course) is a reusable definition: "Mathematics", "BBS Business
// Statistics". Where and when it is taught is a SubjectOffering (a class in
// an academic year); what should be taught is a versioned Curriculum; who
// teaches it is a TeacherAssignment. Exams, timetables, attendance and LMS
// spaces attach to the offering, never to the subject itself.

// The default role of a subject in a class; each offering can differ.
enum SubjectRequirement {
  COMPULSORY
  ELECTIVE
  OPTIONAL
  ADDITIONAL
}

enum CurriculumStatus {
  DRAFT
  ACTIVE
  RETIRED
}

enum CurriculumComponent {
  THEORY
  PRACTICAL
  PROJECT
  MIXED
}

enum OfferingStatus {
  ACTIVE
  DISCONTINUED
}

enum PrerequisiteKind {
  REQUIRED
  RECOMMENDED
}

// Organisation-defined classification: Language, Science, Vocational, ...
model SubjectCategory {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String
  description    String?
  isActive       Boolean  @default(true) @map("is_active")
  sortOrder      Int      @default(0) @map("sort_order")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  subjects     Subject[]

  @@unique([organizationId, name])
  @@unique([id, organizationId])
  @@map("subject_categories")
}

model Subject {
  id               String             @id @default(uuid()) @db.Uuid
  organizationId   String             @map("organization_id") @db.Uuid
  educationLevelId String?            @map("education_level_id") @db.Uuid
  programId        String?            @map("program_id") @db.Uuid
  categoryId       String?            @map("category_id") @db.Uuid
  name             String
  // Optional name in Nepali (e.g. "गणित") for report cards.
  localName        String?            @map("local_name")
  // Unique within the organisation (e.g. NEB codes such as 0081, or MGT201).
  code             String
  description      String?
  requirement      SubjectRequirement @default(COMPULSORY)
  // Decimal credit hours are common (e.g. 3.75); all teaching numbers are optional.
  creditHours      Float?             @map("credit_hours")
  theoryHours      Int?               @map("theory_hours")
  practicalHours   Int?               @map("practical_hours")
  weeklyPeriods    Int?               @map("weekly_periods")
  medium           InstructionMedium?
  isActive         Boolean            @default(true) @map("is_active")
  archivedAt       DateTime?          @map("archived_at")
  sortOrder        Int                @default(0) @map("sort_order")
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")

  organization   Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  educationLevel EducationLevel?       @relation(fields: [educationLevelId, organizationId], references: [id, organizationId], onDelete: NoAction)
  program        Program?              @relation(fields: [programId, organizationId], references: [id, organizationId], onDelete: NoAction)
  category       SubjectCategory?      @relation(fields: [categoryId, organizationId], references: [id, organizationId], onDelete: NoAction)
  assignments    TeacherAssignment[]
  curricula      Curriculum[]
  offerings      SubjectOffering[]
  prerequisites  SubjectPrerequisite[] @relation("SubjectPrerequisites")
  requiredFor    SubjectPrerequisite[] @relation("PrerequisiteOf")

  @@unique([organizationId, code])
  @@unique([id, organizationId])
  @@index([organizationId, educationLevelId, programId])
  @@index([organizationId, archivedAt, name])
  @@map("subjects")
}

// "Accountancy needs Business Studies". Cycles and self-references are
// refused by the service (and self-references by a CHECK constraint).
model SubjectPrerequisite {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  subjectId      String           @map("subject_id") @db.Uuid
  prerequisiteId String           @map("prerequisite_id") @db.Uuid
  kind           PrerequisiteKind @default(REQUIRED)
  // Free text such as "C+" or "Pass"; checked by the results module later.
  minimumGrade   String?          @map("minimum_grade")
  note           String?
  createdAt      DateTime         @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  subject      Subject      @relation("SubjectPrerequisites", fields: [subjectId, organizationId], references: [id, organizationId], onDelete: Cascade)
  prerequisite Subject      @relation("PrerequisiteOf", fields: [prerequisiteId, organizationId], references: [id, organizationId], onDelete: NoAction)

  @@unique([subjectId, prerequisiteId])
  @@index([organizationId, prerequisiteId])
  @@map("subject_prerequisites")
}

// What should be taught: a versioned syllabus for a subject (optionally for
// one level or program). Only drafts are edited; a change to an active
// syllabus is a new version, so offerings keep the version they used.
model Curriculum {
  id                String           @id @default(uuid()) @db.Uuid
  organizationId    String           @map("organization_id") @db.Uuid
  subjectId         String           @map("subject_id") @db.Uuid
  educationLevelId  String?          @map("education_level_id") @db.Uuid
  programId         String?          @map("program_id") @db.Uuid
  name              String
  code              String?
  // Free text: "2078", "v2", "2024 revision".
  version           String
  description       String?
  status            CurriculumStatus @default(DRAFT)
  effectiveFrom     DateTime?        @map("effective_from") @db.Date
  effectiveTo       DateTime?        @map("effective_to") @db.Date
  previousVersionId String?          @map("previous_version_id") @db.Uuid
  // Official syllabus file (private bucket path, never a public URL).
  documentPath      String?          @map("document_path")
  documentName      String?          @map("document_name")
  documentType      String?          @map("document_type")
  documentSize      Int?             @map("document_size")
  createdById       String?          @map("created_by_id") @db.Uuid
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")

  organization    Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  subject         Subject           @relation(fields: [subjectId, organizationId], references: [id, organizationId], onDelete: NoAction)
  educationLevel  EducationLevel?   @relation(fields: [educationLevelId, organizationId], references: [id, organizationId], onDelete: NoAction)
  program         Program?          @relation(fields: [programId, organizationId], references: [id, organizationId], onDelete: NoAction)
  previousVersion Curriculum?       @relation("CurriculumVersions", fields: [previousVersionId], references: [id], onDelete: SetNull)
  nextVersions    Curriculum[]      @relation("CurriculumVersions")
  units           CurriculumUnit[]
  offerings       SubjectOffering[]

  @@unique([subjectId, name, version])
  @@unique([id, organizationId])
  @@unique([id, subjectId])
  @@index([organizationId, subjectId, status])
  @@map("curricula")
}

// A unit or chapter of a curriculum.
model CurriculumUnit {
  id                 String              @id @default(uuid()) @db.Uuid
  organizationId     String              @map("organization_id") @db.Uuid
  curriculumId       String              @map("curriculum_id") @db.Uuid
  title              String
  description        String?
  sequence           Int                 @default(1)
  component          CurriculumComponent @default(THEORY)
  estimatedHours     Int?                @map("estimated_hours")
  learningObjectives String?             @map("learning_objectives")
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  curriculum   Curriculum        @relation(fields: [curriculumId, organizationId], references: [id, organizationId], onDelete: Cascade)
  topics       CurriculumTopic[]

  @@unique([id, organizationId])
  @@index([curriculumId, sequence])
  @@map("curriculum_units")
}

model CurriculumTopic {
  id                 String   @id @default(uuid()) @db.Uuid
  organizationId     String   @map("organization_id") @db.Uuid
  unitId             String   @map("unit_id") @db.Uuid
  title              String
  description        String?
  sequence           Int      @default(1)
  estimatedHours     Int?     @map("estimated_hours")
  learningObjectives String?  @map("learning_objectives")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  unit         CurriculumUnit @relation(fields: [unitId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@index([unitId, sequence])
  @@map("curriculum_topics")
}

// "Optional I", "Elective group A": a set of offerings of one class in one
// year from which students choose between minChoices and maxChoices.
model ElectiveGroup {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  academicYearId String   @map("academic_year_id") @db.Uuid
  classId        String   @map("class_id") @db.Uuid
  name           String
  description    String?
  minChoices     Int      @default(1) @map("min_choices")
  maxChoices     Int      @default(1) @map("max_choices")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  academicYear AcademicYear      @relation(fields: [academicYearId, organizationId], references: [id, organizationId], onDelete: NoAction)
  class        AcademicClass     @relation(fields: [classId, organizationId], references: [id, organizationId], onDelete: NoAction)
  offerings    SubjectOffering[]
  batch        Batch?            @relation(fields: [batchId], references: [id])
  batchId      String?           @db.Uuid

  @@unique([academicYearId, classId, name])
  @@unique([id, organizationId])
  @@map("elective_groups")
}

// A subject taught in one class (grade, year, semester, cohort) in one
// academic year. Past years' offerings are never rewritten by later changes.
model SubjectOffering {
  id              String             @id @default(uuid()) @db.Uuid
  organizationId  String             @map("organization_id") @db.Uuid
  subjectId       String             @map("subject_id") @db.Uuid
  academicYearId  String             @map("academic_year_id") @db.Uuid
  classId         String             @map("class_id") @db.Uuid
  curriculumId    String?            @map("curriculum_id") @db.Uuid
  electiveGroupId String?            @map("elective_group_id") @db.Uuid
  requirement     SubjectRequirement @default(COMPULSORY)
  // Offering-specific values; null means "use the subject's".
  creditHours     Float?             @map("credit_hours")
  weeklyPeriods   Int?               @map("weekly_periods")
  code            String?
  status          OfferingStatus     @default(ACTIVE)
  notes           String?
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")

  organization        Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  subject             Subject                  @relation(fields: [subjectId, organizationId], references: [id, organizationId], onDelete: NoAction)
  academicYear        AcademicYear             @relation(fields: [academicYearId, organizationId], references: [id, organizationId], onDelete: NoAction)
  class               AcademicClass            @relation(fields: [classId, organizationId], references: [id, organizationId], onDelete: NoAction)
  // The curriculum must be one of this subject's.
  curriculum          Curriculum?              @relation(fields: [curriculumId, subjectId], references: [id, subjectId], onDelete: NoAction)
  electiveGroup       ElectiveGroup?           @relation(fields: [electiveGroupId, organizationId], references: [id, organizationId], onDelete: NoAction)
  sections            SubjectOfferingSection[]
  batch               Batch?                   @relation(fields: [batchId], references: [id])
  batchId             String?                  @db.Uuid
  attendanceSessions  AttendanceSession[]
  examinationSubjects ExaminationSubject[]

  @@unique([academicYearId, classId, subjectId])
  @@unique([id, organizationId])
  @@unique([id, classId])
  @@index([organizationId, subjectId])
  @@index([organizationId, academicYearId, classId])
  @@map("subject_offerings")
}

// Limits an offering to some sections of its class (an elective taught only
// in section B). No rows means every section. The section is checked against
// the offering's class by the database itself.
model SubjectOfferingSection {
  offeringId     String   @map("offering_id") @db.Uuid
  sectionId      String   @map("section_id") @db.Uuid
  classId        String   @map("class_id") @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  offering     SubjectOffering @relation(fields: [offeringId, classId], references: [id, classId], onDelete: Cascade)
  section      Section         @relation(fields: [sectionId, classId], references: [id, classId], onDelete: NoAction)

  @@id([offeringId, sectionId])
  @@index([sectionId])
  @@map("subject_offering_sections")
}

// Who a designation is offered to. A job title is never a permission.
enum DesignationScope {
  ALL
  TEACHING
  NON_TEACHING
}

// Broad grouping for reporting and filters; the titles themselves are free.
enum JobCategory {
  ADMINISTRATION
  FINANCE
  FRONT_OFFICE
  LIBRARY
  LABORATORY
  IT
  STUDENT_SERVICES
  EXAMINATION
  TRANSPORT
  HOSTEL
  HEALTH
  SECURITY
  FACILITIES
  TEACHING
  OTHER
}

// Configurable job titles shared by teachers and staff: Teacher, Lecturer,
// Accountant, Librarian, Driver, ...
model Designation {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  name           String
  scope          DesignationScope @default(ALL)
  category       JobCategory?
  // Usual department for this title (staff departments only); optional.
  departmentId   String?          @map("department_id") @db.Uuid
  isActive       Boolean          @default(true) @map("is_active")
  sortOrder      Int              @default(0) @map("sort_order")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  department   Department?  @relation(fields: [departmentId, organizationId], references: [id, organizationId], onDelete: NoAction)
  teachers     Teacher[]
  staff        Staff[]

  @@unique([organizationId, name])
  @@unique([id, organizationId])
  @@map("designations")
}

// Per-organisation employee ID rules.
model StaffSettings {
  organizationId       String        @id @map("organization_id") @db.Uuid
  employeeIdMode       NumberingMode @default(AUTOMATIC) @map("employee_id_mode")
  employeeIdPrefix     String        @default("EMP-") @map("employee_id_prefix")
  employeeIdPadding    Int           @default(4) @map("employee_id_padding")
  // Next value to hand out; incremented atomically (UPDATE ... RETURNING).
  nextEmployeeSequence Int           @default(1) @map("next_employee_sequence")
  updatedAt            DateTime      @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("staff_settings")
}

model Teacher {
  id                           String    @id @default(uuid()) @db.Uuid
  organizationId               String    @map("organization_id") @db.Uuid
  // Login account, if the teacher has one (must be a member of this organisation).
  userId                       String?   @map("user_id") @db.Uuid
  employeeId                   String    @map("employee_id")
  firstName                    String    @map("first_name")
  middleName                   String?   @map("middle_name")
  lastName                     String    @map("last_name")
  // Full name in Devanagari, for institutions that keep bilingual records.
  nameNepali                   String?   @map("name_nepali")
  // Restricted (teachers.sensitive.view): date of birth, addresses, emergency contact.
  dateOfBirth                  DateTime? @map("date_of_birth") @db.Date
  gender                       Gender?
  nationality                  String?
  profileImagePath             String?   @map("profile_image_path")
  email                        String?
  phone                        String?
  alternatePhone               String?   @map("alternate_phone")
  emergencyContactName         String?   @map("emergency_contact_name")
  emergencyContactPhone        String?   @map("emergency_contact_phone")
  emergencyContactRelationship String?   @map("emergency_contact_relationship")

  // Current employment. Every change is also recorded in TeacherEmploymentRecord.
  dateOfJoining     DateTime                @map("date_of_joining") @db.Date
  employmentType    TeacherEmploymentType   @default(FULL_TIME) @map("employment_type")
  employmentStatus  TeacherEmploymentStatus @default(ACTIVE) @map("employment_status")
  designationId     String?                 @map("designation_id") @db.Uuid
  // Null = not recorded.
  academicRank      AcademicRank?           @map("academic_rank")
  departmentId      String?                 @map("department_id") @db.Uuid
  reportingToId     String?                 @map("reporting_to_id") @db.Uuid
  contractStartDate DateTime?               @map("contract_start_date") @db.Date
  contractEndDate   DateTime?               @map("contract_end_date") @db.Date
  onProbation       Boolean                 @default(false) @map("on_probation")
  probationEndDate  DateTime?               @map("probation_end_date") @db.Date
  employmentNotes   String?                 @map("employment_notes")
  // Holds a full-time job at another institution (UGC limits this for
  // full-time faculty). Null = not recorded. Employment access only.
  fullTimeElsewhere Boolean?                @map("full_time_elsewhere")

  archivedAt   DateTime? @map("archived_at")
  archivedById String?   @map("archived_by_id") @db.Uuid
  createdById  String?   @map("created_by_id") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  organization      Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user              User?                     @relation(fields: [userId], references: [id], onDelete: SetNull)
  designation       Designation?              @relation(fields: [designationId, organizationId], references: [id, organizationId], onDelete: NoAction)
  department        Faculty?                  @relation(fields: [departmentId, organizationId], references: [id, organizationId], onDelete: NoAction)
  // Plain FK: removing a manager clears the link (same organisation is checked in code).
  reportingTo       Teacher?                  @relation("TeacherReporting", fields: [reportingToId], references: [id], onDelete: SetNull)
  reports           Teacher[]                 @relation("TeacherReporting")
  addresses         TeacherAddress[]
  employmentRecords TeacherEmploymentRecord[]
  qualifications    TeacherQualification[]
  certifications    TeacherCertification[]
  documents         TeacherDocument[]
  assignments       TeacherAssignment[]
  attendance        EmployeeAttendance[]

  @@unique([organizationId, employeeId])
  @@unique([id, organizationId])
  @@unique([organizationId, userId])
  @@index([organizationId, employmentStatus, archivedAt])
  @@index([organizationId, lastName, firstName])
  @@index([organizationId, dateOfJoining])
  @@index([organizationId, departmentId])
  @@index([organizationId, designationId])
  @@index([organizationId, academicRank])
  @@map("teachers")
}

model TeacherAddress {
  id           String      @id @default(uuid()) @db.Uuid
  teacherId    String      @map("teacher_id") @db.Uuid
  type         AddressType
  province     Int?
  district     String?
  municipality String?
  wardNumber   Int?        @map("ward_number")
  tole         String?
  street       String?
  postalCode   String?     @map("postal_code")
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  teacher Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@unique([teacherId, type])
  @@map("teacher_addresses")
}

// Append-only employment history: one row per change, with names copied so
// renaming or removing a designation never rewrites history.
model TeacherEmploymentRecord {
  id                String                  @id @default(uuid()) @db.Uuid
  organizationId    String                  @map("organization_id") @db.Uuid
  teacherId         String                  @map("teacher_id") @db.Uuid
  effectiveDate     DateTime                @map("effective_date") @db.Date
  employmentType    TeacherEmploymentType   @map("employment_type")
  employmentStatus  TeacherEmploymentStatus @map("employment_status")
  designationName   String?                 @map("designation_name")
  academicRank      AcademicRank?           @map("academic_rank")
  departmentName    String?                 @map("department_name")
  contractStartDate DateTime?               @map("contract_start_date") @db.Date
  contractEndDate   DateTime?               @map("contract_end_date") @db.Date
  onProbation       Boolean                 @default(false) @map("on_probation")
  note              String?
  changedById       String?                 @map("changed_by_id") @db.Uuid
  createdAt         DateTime                @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  teacher      Teacher      @relation(fields: [teacherId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@index([teacherId, effectiveDate])
  @@map("teacher_employment_records")
}

model TeacherQualification {
  id                 String             @id @default(uuid()) @db.Uuid
  organizationId     String             @map("organization_id") @db.Uuid
  teacherId          String             @map("teacher_id") @db.Uuid
  level              QualificationLevel
  // e.g. "M.Ed. in Mathematics Education", "B.Sc. CSIT"
  title              String
  specialization     String?
  institutionName    String?            @map("institution_name")
  awardingBody       String?            @map("awarding_body")
  country            String?
  completionYear     Int?               @map("completion_year")
  // Grade, GPA or percentage as written on the certificate.
  result             String?
  documentId         String?            @map("document_id") @db.Uuid
  verificationStatus VerificationStatus @default(PENDING) @map("verification_status")
  verifiedAt         DateTime?          @map("verified_at")
  verifiedById       String?            @map("verified_by_id") @db.Uuid
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  teacher      Teacher          @relation(fields: [teacherId, organizationId], references: [id, organizationId], onDelete: Cascade)
  document     TeacherDocument? @relation("QualificationDocument", fields: [documentId], references: [id], onDelete: SetNull)

  @@index([organizationId, level])
  @@index([teacherId])
  @@map("teacher_qualifications")
}

model TeacherCertification {
  id                  String             @id @default(uuid()) @db.Uuid
  organizationId      String             @map("organization_id") @db.Uuid
  teacherId           String             @map("teacher_id") @db.Uuid
  name                String
  // Training, workshop, seminar, … Null = not recorded.
  category            DevelopmentType?
  issuingOrganization String?            @map("issuing_organization")
  issueDate           DateTime?          @map("issue_date") @db.Date
  expiryDate          DateTime?          @map("expiry_date") @db.Date
  reference           String?
  documentId          String?            @map("document_id") @db.Uuid
  verificationStatus  VerificationStatus @default(PENDING) @map("verification_status")
  verifiedAt          DateTime?          @map("verified_at")
  verifiedById        String?            @map("verified_by_id") @db.Uuid
  createdAt           DateTime           @default(now()) @map("created_at")
  updatedAt           DateTime           @updatedAt @map("updated_at")

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  teacher      Teacher          @relation(fields: [teacherId, organizationId], references: [id, organizationId], onDelete: Cascade)
  document     TeacherDocument? @relation("CertificationDocument", fields: [documentId], references: [id], onDelete: SetNull)

  @@index([teacherId])
  @@map("teacher_certifications")
}

model TeacherDocument {
  id                 String                  @id @default(uuid()) @db.Uuid
  organizationId     String                  @map("organization_id") @db.Uuid
  teacherId          String                  @map("teacher_id") @db.Uuid
  category           TeacherDocumentCategory
  requirementId      String?                 @map("requirement_id") @db.Uuid
  title              String
  fileName           String                  @map("file_name")
  mimeType           String                  @map("mime_type")
  sizeBytes          Int                     @map("size_bytes")
  storagePath        String                  @unique @map("storage_path")
  verificationStatus VerificationStatus      @default(PENDING) @map("verification_status")
  verifiedAt         DateTime?               @map("verified_at")
  verifiedById       String?                 @map("verified_by_id") @db.Uuid
  uploadedById       String?                 @map("uploaded_by_id") @db.Uuid
  createdAt          DateTime                @default(now()) @map("created_at")

  organization   Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  teacher        Teacher                @relation(fields: [teacherId, organizationId], references: [id, organizationId], onDelete: Cascade)
  requirement    DocumentRequirement?   @relation(fields: [requirementId], references: [id], onDelete: SetNull)
  qualifications TeacherQualification[] @relation("QualificationDocument")
  certifications TeacherCertification[] @relation("CertificationDocument")

  @@index([organizationId, teacherId])
  @@index([requirementId])
  @@map("teacher_documents")
}

// What a teacher teaches, in which academic year. Only the year is required;
// schools, +2 colleges and universities fill in what applies (a class and
// section, a program, a subject, a batch). Changing class or subject ends
// this row and creates a new one, so assignment history is preserved.
model TeacherAssignment {
  id               String           @id @default(uuid()) @db.Uuid
  organizationId   String           @map("organization_id") @db.Uuid
  teacherId        String           @map("teacher_id") @db.Uuid
  academicYearId   String           @map("academic_year_id") @db.Uuid
  educationLevelId String?          @map("education_level_id") @db.Uuid
  programId        String?          @map("program_id") @db.Uuid
  classId          String?          @map("class_id") @db.Uuid
  sectionId        String?          @map("section_id") @db.Uuid
  subjectId        String?          @map("subject_id") @db.Uuid
  batchId          String?          @map("batch_id") @db.Uuid
  role             TeachingRole     @default(SUBJECT_TEACHER)
  status           AssignmentStatus @default(ACTIVE)
  startDate        DateTime         @map("start_date") @db.Date
  endDate          DateTime?        @map("end_date") @db.Date
  weeklyPeriods    Int?             @map("weekly_periods")
  notes            String?
  endReason        String?          @map("end_reason")
  assignedById     String?          @map("assigned_by_id") @db.Uuid
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  teacher        Teacher         @relation(fields: [teacherId, organizationId], references: [id, organizationId], onDelete: NoAction)
  academicYear   AcademicYear    @relation(fields: [academicYearId, organizationId], references: [id, organizationId], onDelete: NoAction)
  educationLevel EducationLevel? @relation(fields: [educationLevelId, organizationId], references: [id, organizationId], onDelete: NoAction)
  program        Program?        @relation(fields: [programId, organizationId], references: [id, organizationId], onDelete: NoAction)
  class          AcademicClass?  @relation(fields: [classId, organizationId], references: [id, organizationId], onDelete: NoAction)
  section        Section?        @relation(fields: [sectionId, classId], references: [id, classId], onDelete: NoAction)
  subject        Subject?        @relation(fields: [subjectId, organizationId], references: [id, organizationId], onDelete: NoAction)
  batch          Batch?          @relation(fields: [batchId, organizationId], references: [id, organizationId], onDelete: NoAction)

  // One active class teacher per class/section per year.
  @@unique([academicYearId, classId, sectionId], map: "teacher_assignments_class_teacher_key", where: raw("status = 'ACTIVE' AND role = 'CLASS_TEACHER' AND section_id IS NOT NULL"))
  @@unique([academicYearId, classId], map: "teacher_assignments_class_teacher_no_section_key", where: raw("status = 'ACTIVE' AND role = 'CLASS_TEACHER' AND section_id IS NULL AND class_id IS NOT NULL"))
  @@index([organizationId, academicYearId, status])
  @@index([teacherId, status])
  @@index([organizationId, classId, sectionId])
  @@index([organizationId, subjectId])
  @@index([organizationId, programId])
  @@map("teacher_assignments")
}

// ================================================================== staff
//
// Non-teaching employees. Same shape as the teacher module: an organisation-
// specific profile, separate from the login account (User), with employment
// history, qualifications, documents and extra responsibilities as separate
// records so history is never overwritten. Teachers and staff share
// designations, document types and one employee ID sequence (unique across
// both tables, enforced by a trigger). Salary, bank and tax details belong to
// the payroll module and are deliberately not stored here.

enum StaffEmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  TEMPORARY
  CASUAL
  OTHER
}

// Employment lifecycle. Archiving (archived_at) is separate.
enum StaffEmploymentStatus {
  ACTIVE
  ON_LEAVE
  SUSPENDED
  RESIGNED
  TERMINATED
  RETIRED
  CONTRACT_EXPIRED
}

enum StaffQualificationKind {
  ACADEMIC
  CERTIFICATION
  TRAINING
}

enum StaffDocumentCategory {
  CV
  ACADEMIC_CERTIFICATE
  PROFESSIONAL_CERTIFICATE
  TRAINING_CERTIFICATE
  APPOINTMENT_LETTER
  CONTRACT
  EXPERIENCE_LETTER
  IDENTITY
  OTHER
}

// Administrative and support departments (Administration, Library, Finance,
// Transport, ...). Academic faculties/departments stay in Faculty.
model Department {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String
  code           String
  description    String?
  isActive       Boolean  @default(true) @map("is_active")
  sortOrder      Int      @default(0) @map("sort_order")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  staff        Staff[]
  designations Designation[]
  assignments  StaffAssignment[]

  @@unique([organizationId, code])
  @@unique([organizationId, name])
  @@unique([id, organizationId])
  @@map("departments")
}

model Staff {
  id                           String    @id @default(uuid()) @db.Uuid
  organizationId               String    @map("organization_id") @db.Uuid
  // Login account, if any (must be a member of this organisation). Creating a
  // profile never creates an account.
  userId                       String?   @map("user_id") @db.Uuid
  employeeId                   String    @map("employee_id")
  firstName                    String    @map("first_name")
  middleName                   String?   @map("middle_name")
  lastName                     String    @map("last_name")
  nameNepali                   String?   @map("name_nepali")
  // Restricted (staff.sensitive.view): date of birth, addresses, emergency contact.
  dateOfBirth                  DateTime? @map("date_of_birth") @db.Date
  gender                       Gender?
  nationality                  String?
  profileImagePath             String?   @map("profile_image_path")
  email                        String?
  phone                        String?
  alternatePhone               String?   @map("alternate_phone")
  emergencyContactName         String?   @map("emergency_contact_name")
  emergencyContactPhone        String?   @map("emergency_contact_phone")
  emergencyContactRelationship String?   @map("emergency_contact_relationship")

  // Current employment. Every change is also recorded in StaffEmploymentRecord.
  dateOfJoining      DateTime              @map("date_of_joining") @db.Date
  employmentType     StaffEmploymentType   @default(FULL_TIME) @map("employment_type")
  employmentStatus   StaffEmploymentStatus @default(ACTIVE) @map("employment_status")
  designationId      String?               @map("designation_id") @db.Uuid
  departmentId       String?               @map("department_id") @db.Uuid
  reportingToId      String?               @map("reporting_to_id") @db.Uuid
  contractStartDate  DateTime?             @map("contract_start_date") @db.Date
  contractEndDate    DateTime?             @map("contract_end_date") @db.Date
  onProbation        Boolean               @default(false) @map("on_probation")
  probationStartDate DateTime?             @map("probation_start_date") @db.Date
  probationEndDate   DateTime?             @map("probation_end_date") @db.Date
  // Leaving details (restricted to staff.employment.view).
  resignationDate    DateTime?             @map("resignation_date") @db.Date
  lastWorkingDate    DateTime?             @map("last_working_date") @db.Date
  terminationDate    DateTime?             @map("termination_date") @db.Date
  leavingReason      String?               @map("leaving_reason")
  employmentNotes    String?               @map("employment_notes")

  archivedAt   DateTime? @map("archived_at")
  archivedById String?   @map("archived_by_id") @db.Uuid
  createdById  String?   @map("created_by_id") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  organization      Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user              User?                   @relation(fields: [userId], references: [id], onDelete: SetNull)
  designation       Designation?            @relation(fields: [designationId, organizationId], references: [id, organizationId], onDelete: NoAction)
  department        Department?             @relation(fields: [departmentId, organizationId], references: [id, organizationId], onDelete: NoAction)
  // Plain FK: removing a manager clears the link (same organisation is checked in code).
  reportingTo       Staff?                  @relation("StaffReporting", fields: [reportingToId], references: [id], onDelete: SetNull)
  reports           Staff[]                 @relation("StaffReporting")
  addresses         StaffAddress[]
  employmentRecords StaffEmploymentRecord[]
  qualifications    StaffQualification[]
  documents         StaffDocument[]
  assignments       StaffAssignment[]
  attendance        EmployeeAttendance[]

  @@unique([organizationId, employeeId])
  @@unique([id, organizationId])
  @@unique([organizationId, userId])
  @@index([organizationId, employmentStatus, archivedAt])
  @@index([organizationId, lastName, firstName])
  @@index([organizationId, dateOfJoining])
  @@index([organizationId, contractEndDate])
  @@index([organizationId, departmentId])
  @@index([organizationId, designationId])
  @@map("staff")
}

model StaffAddress {
  id           String      @id @default(uuid()) @db.Uuid
  staffId      String      @map("staff_id") @db.Uuid
  type         AddressType
  province     Int?
  district     String?
  municipality String?
  wardNumber   Int?        @map("ward_number")
  tole         String?
  street       String?
  postalCode   String?     @map("postal_code")
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  staff Staff @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@unique([staffId, type])
  @@map("staff_addresses")
}

// Append-only employment history: one row per change, with names copied so
// renaming or removing a department or designation never rewrites history.
model StaffEmploymentRecord {
  id                String                @id @default(uuid()) @db.Uuid
  organizationId    String                @map("organization_id") @db.Uuid
  staffId           String                @map("staff_id") @db.Uuid
  effectiveDate     DateTime              @map("effective_date") @db.Date
  employmentType    StaffEmploymentType   @map("employment_type")
  employmentStatus  StaffEmploymentStatus @map("employment_status")
  designationName   String?               @map("designation_name")
  departmentName    String?               @map("department_name")
  contractStartDate DateTime?             @map("contract_start_date") @db.Date
  contractEndDate   DateTime?             @map("contract_end_date") @db.Date
  onProbation       Boolean               @default(false) @map("on_probation")
  note              String?
  changedById       String?               @map("changed_by_id") @db.Uuid
  createdAt         DateTime              @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  staff        Staff        @relation(fields: [staffId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@index([staffId, effectiveDate])
  @@map("staff_employment_records")
}

// Academic qualifications, professional certifications and training in one
// list, told apart by `kind`.
model StaffQualification {
  id                 String                 @id @default(uuid()) @db.Uuid
  organizationId     String                 @map("organization_id") @db.Uuid
  staffId            String                 @map("staff_id") @db.Uuid
  kind               StaffQualificationKind @default(ACADEMIC)
  // Required for academic qualifications; optional for certifications/training.
  level              QualificationLevel?
  // e.g. "BBS", "Bachelor in Library Science", "CA Inter", "CCNA"
  title              String
  specialization     String?
  institutionName    String?                @map("institution_name")
  awardingBody       String?                @map("awarding_body")
  country            String?
  completionYear     Int?                   @map("completion_year")
  expiryDate         DateTime?              @map("expiry_date") @db.Date
  // Grade, GPA or percentage as written on the certificate.
  result             String?
  documentId         String?                @map("document_id") @db.Uuid
  verificationStatus VerificationStatus     @default(PENDING) @map("verification_status")
  verifiedAt         DateTime?              @map("verified_at")
  verifiedById       String?                @map("verified_by_id") @db.Uuid
  createdAt          DateTime               @default(now()) @map("created_at")
  updatedAt          DateTime               @updatedAt @map("updated_at")

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  staff        Staff          @relation(fields: [staffId, organizationId], references: [id, organizationId], onDelete: Cascade)
  document     StaffDocument? @relation(fields: [documentId], references: [id], onDelete: SetNull)

  @@index([organizationId, kind, level])
  @@index([staffId])
  @@map("staff_qualifications")
}

model StaffDocument {
  id                 String                @id @default(uuid()) @db.Uuid
  organizationId     String                @map("organization_id") @db.Uuid
  staffId            String                @map("staff_id") @db.Uuid
  category           StaffDocumentCategory
  requirementId      String?               @map("requirement_id") @db.Uuid
  title              String
  fileName           String                @map("file_name")
  mimeType           String                @map("mime_type")
  sizeBytes          Int                   @map("size_bytes")
  storagePath        String                @unique @map("storage_path")
  verificationStatus VerificationStatus    @default(PENDING) @map("verification_status")
  verifiedAt         DateTime?             @map("verified_at")
  verifiedById       String?               @map("verified_by_id") @db.Uuid
  uploadedById       String?               @map("uploaded_by_id") @db.Uuid
  createdAt          DateTime              @default(now()) @map("created_at")

  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  staff          Staff                @relation(fields: [staffId, organizationId], references: [id, organizationId], onDelete: Cascade)
  requirement    DocumentRequirement? @relation(fields: [requirementId], references: [id], onDelete: SetNull)
  qualifications StaffQualification[]

  @@index([organizationId, staffId])
  @@index([requirementId])
  @@map("staff_documents")
}

// Additional responsibilities (library, lab supervision, exam duty, hostel
// warden, ...). Separate from employment status and from permissions.
// Ending one keeps it as history.
model StaffAssignment {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  staffId        String           @map("staff_id") @db.Uuid
  title          String
  departmentId   String?          @map("department_id") @db.Uuid
  status         AssignmentStatus @default(ACTIVE)
  startDate      DateTime         @map("start_date") @db.Date
  endDate        DateTime?        @map("end_date") @db.Date
  notes          String?
  endReason      String?          @map("end_reason")
  assignedById   String?          @map("assigned_by_id") @db.Uuid
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  staff        Staff        @relation(fields: [staffId, organizationId], references: [id, organizationId], onDelete: NoAction)
  department   Department?  @relation(fields: [departmentId, organizationId], references: [id, organizationId], onDelete: NoAction)

  @@index([organizationId, status])
  @@index([staffId, status])
  @@map("staff_assignments")
}

// ============================================================== attendance
//
// Attendance is taken in sessions (one register: Grade 8 A on a date, or
// Grade 11 Science A's Physics period 2), each holding one record per
// student actually marked. A student without a record was not marked; that
// is never read as absent. Teacher and staff attendance is a separate, per-
// day record because its rules (check-in, leave, employment dates) differ.
// Every rule that varies between institutions lives in AttendancePolicy.

// What a session covers: the whole day (optionally in slots, e.g. morning and
// afternoon) or one period of one subject offering.
enum AttendanceSessionType {
  DAILY
  PERIOD
}

// DRAFT: still being taken. SUBMITTED: final; changes go through corrections.
// LOCKED: closed; only someone allowed to approve can reopen it.
enum AttendanceSessionStatus {
  DRAFT
  SUBMITTED
  LOCKED
}

// One controlled list for students and employees. How each status counts
// towards percentages is decided by the policy (features/attendance/
// calculation.ts), never by the client.
enum AttendanceStatus {
  PRESENT
  LATE
  HALF_DAY
  ABSENT
  EXCUSED
  ON_LEAVE
}

// How excused absences and approved leave affect percentages.
enum ExcusedTreatment {
  // Left out of both attended and conducted sessions.
  EXCLUDE
  COUNT_AS_ABSENT
  COUNT_AS_PRESENT
}

enum AttendanceCorrectionStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum EmployeeType {
  TEACHER
  STAFF
}

enum AttendanceSource {
  MANUAL
  SELF_SERVICE
  IMPORT
  // Reserved for a future biometric/RFID integration; nothing writes it yet.
  DEVICE
}

enum HolidayAudience {
  ALL
  STUDENTS
  EMPLOYEES
}

enum AttendanceAlertKind {
  BELOW_THRESHOLD
  APPROACHING_THRESHOLD
}

// Per-organisation attendance rules. A missing row means the defaults below.
model AttendancePolicy {
  organizationId             String            @id @map("organization_id") @db.Uuid
  // Which kinds of student registers this institution keeps.
  dailyEnabled               Boolean           @default(true) @map("daily_enabled")
  periodEnabled              Boolean           @default(false) @map("period_enabled")
  // Daily registers per day: 1 (full day) or 2 (morning and afternoon).
  dailySlots                 Int               @default(1) @map("daily_slots")
  // Highest period number offered in the period picker (not a timetable).
  maxPeriodsPerDay           Int               @default(8) @map("max_periods_per_day")
  // Status a new register starts with in the form; null starts unmarked.
  // Nothing is recorded until someone saves.
  defaultStatus              AttendanceStatus? @default(PRESENT) @map("default_status")
  halfDayEnabled             Boolean           @default(false) @map("half_day_enabled")
  lateCountsAsPresent        Boolean           @default(true) @map("late_counts_as_present")
  excusedTreatment           ExcusedTreatment  @default(EXCLUDE) @map("excused_treatment")
  minimumPercentage          Int               @default(75) @map("minimum_percentage")
  // "Approaching" = below minimum + margin.
  warningMarginPercentage    Int               @default(5) @map("warning_margin_percentage")
  // Corrections by people without attendance.approve wait for a reviewer.
  correctionsRequireApproval Boolean           @default(true) @map("corrections_require_approval")
  // Submitted registers older than this many days count as locked.
  lockAfterDays              Int?              @map("lock_after_days")
  // 0 = Sunday … 6 = Saturday. Saturday is the usual weekly holiday in Nepal.
  weeklyOffDays              Int[]             @default([6]) @map("weekly_off_days")
  allowOnNonWorkingDays      Boolean           @default(false) @map("allow_on_non_working_days")
  notifyGuardiansOnAbsence   Boolean           @default(false) @map("notify_guardians_on_absence")
  notifyGuardiansOnLate      Boolean           @default(false) @map("notify_guardians_on_late")
  // Teacher and staff attendance.
  employeeAttendanceEnabled  Boolean           @default(true) @map("employee_attendance_enabled")
  employeeSelfCheckIn        Boolean           @default(false) @map("employee_self_check_in")
  // "HH:MM" local time the working day starts, and minutes of grace before
  // a check-in counts as late.
  workdayStartTime           String            @default("10:00") @map("workday_start_time")
  lateGraceMinutes           Int               @default(10) @map("late_grace_minutes")
  updatedAt                  DateTime          @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("attendance_policies")
}

// Public and institution holidays (Dashain, Tihar, exam breaks, ...). Weekly
// off days come from the policy. Dates are inclusive.
model Holiday {
  id               String          @id @default(uuid()) @db.Uuid
  organizationId   String          @map("organization_id") @db.Uuid
  name             String
  startDate        DateTime        @map("start_date") @db.Date
  endDate          DateTime        @map("end_date") @db.Date
  appliesTo        HolidayAudience @default(ALL) @map("applies_to")
  // Optional: a holiday for one education level only (e.g. +2 exam leave).
  educationLevelId String?         @map("education_level_id") @db.Uuid
  description      String?
  createdById      String?         @map("created_by_id") @db.Uuid
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  educationLevel EducationLevel? @relation(fields: [educationLevelId, organizationId], references: [id, organizationId], onDelete: NoAction)

  @@index([organizationId, startDate, endDate])
  @@map("holidays")
}

// One register. The scope (year, class, section, subject offering, date,
// slot) never changes after creation; scope_key ("DAILY:1",
// "PERIOD:<offering>:3") is copied onto each record so the database itself
// refuses marking a student twice for the same thing on the same day.
model AttendanceSession {
  id                String                  @id @default(uuid()) @db.Uuid
  organizationId    String                  @map("organization_id") @db.Uuid
  academicYearId    String                  @map("academic_year_id") @db.Uuid
  sessionType       AttendanceSessionType   @map("session_type")
  date              DateTime                @db.Date
  // Daily slot (1 = full day/morning, 2 = afternoon) or period number.
  slot              Int                     @default(1)
  scopeKey          String                  @map("scope_key")
  classId           String                  @map("class_id") @db.Uuid
  // Null: the whole class (a class without sections, or a combined lecture).
  sectionId         String?                 @map("section_id") @db.Uuid
  // Required for PERIOD sessions, absent for DAILY ones (CHECK constraint).
  subjectOfferingId String?                 @map("subject_offering_id") @db.Uuid
  status            AttendanceSessionStatus @default(DRAFT)
  notes             String?
  takenById         String?                 @map("taken_by_id") @db.Uuid
  submittedById     String?                 @map("submitted_by_id") @db.Uuid
  submittedAt       DateTime?               @map("submitted_at")
  lockedById        String?                 @map("locked_by_id") @db.Uuid
  lockedAt          DateTime?               @map("locked_at")
  // Guardian notices are prepared once, on first submission.
  notifiedAt        DateTime?               @map("notified_at")
  createdAt         DateTime                @default(now()) @map("created_at")
  updatedAt         DateTime                @updatedAt @map("updated_at")

  organization    Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  academicYear    AcademicYear        @relation(fields: [academicYearId, organizationId], references: [id, organizationId], onDelete: NoAction)
  class           AcademicClass       @relation(fields: [classId, organizationId], references: [id, organizationId], onDelete: NoAction)
  section         Section?            @relation(fields: [sectionId, classId], references: [id, classId], onDelete: NoAction)
  // The offering must be one of this class's.
  subjectOffering SubjectOffering?    @relation(fields: [subjectOfferingId, classId], references: [id, classId], onDelete: NoAction)
  takenBy         User?               @relation("AttendanceSessionTakenBy", fields: [takenById], references: [id], onDelete: SetNull)
  records         StudentAttendance[]

  @@unique([id, organizationId])
  @@unique([classId, date, scopeKey], map: "attendance_sessions_class_scope_key", where: raw("section_id IS NULL"))
  @@unique([sectionId, date, scopeKey], map: "attendance_sessions_section_scope_key", where: raw("section_id IS NOT NULL"))
  @@index([organizationId, date, status])
  @@index([organizationId, academicYearId, classId, date])
  @@index([organizationId, subjectOfferingId, date])
  @@map("attendance_sessions")
}

// One student's attendance in one session. Year, class, offering, date and
// scope are copied from the session (and the section from the student's
// enrollment) when the record is created, for reporting without joins.
model StudentAttendance {
  id                String                @id @default(uuid()) @db.Uuid
  organizationId    String                @map("organization_id") @db.Uuid
  sessionId         String                @map("session_id") @db.Uuid
  studentId         String                @map("student_id") @db.Uuid
  enrollmentId      String                @map("enrollment_id") @db.Uuid
  academicYearId    String                @map("academic_year_id") @db.Uuid
  classId           String                @map("class_id") @db.Uuid
  sectionId         String?               @map("section_id") @db.Uuid
  subjectOfferingId String?               @map("subject_offering_id") @db.Uuid
  sessionType       AttendanceSessionType @map("session_type")
  date              DateTime              @db.Date
  scopeKey          String                @map("scope_key")
  status            AttendanceStatus
  checkInAt         DateTime?             @map("check_in_at")
  checkOutAt        DateTime?             @map("check_out_at")
  lateMinutes       Int?                  @map("late_minutes")
  // Shared with the student and guardians (e.g. "fever").
  reason            String?
  // Internal staff note; never shown in the portals.
  remarks           String?
  markedById        String?               @map("marked_by_id") @db.Uuid
  correctedById     String?               @map("corrected_by_id") @db.Uuid
  correctedAt       DateTime?             @map("corrected_at")
  createdAt         DateTime              @default(now()) @map("created_at")
  updatedAt         DateTime              @updatedAt @map("updated_at")

  organization Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  session      AttendanceSession      @relation(fields: [sessionId, organizationId], references: [id, organizationId], onDelete: Cascade)
  student      Student                @relation(fields: [studentId, organizationId], references: [id, organizationId], onDelete: Cascade)
  // The enrollment must be this student's.
  enrollment   Enrollment             @relation(fields: [enrollmentId, studentId], references: [id, studentId], onDelete: NoAction)
  markedBy     User?                  @relation("StudentAttendanceMarkedBy", fields: [markedById], references: [id], onDelete: SetNull)
  corrections  AttendanceCorrection[]

  @@unique([sessionId, studentId])
  @@unique([id, organizationId])
  // Never two marks for the same student, day and daily slot / subject period.
  @@unique([studentId, date, scopeKey])
  @@index([organizationId, date, status])
  @@index([organizationId, academicYearId, classId, sectionId, date])
  @@index([organizationId, subjectOfferingId, date])
  @@index([studentId, academicYearId, date])
  @@map("student_attendance")
}

// A teacher's or staff member's attendance for one working day.
model EmployeeAttendance {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  employeeType   EmployeeType     @map("employee_type")
  teacherId      String?          @map("teacher_id") @db.Uuid
  staffId        String?          @map("staff_id") @db.Uuid
  date           DateTime         @db.Date
  status         AttendanceStatus
  checkInAt      DateTime?        @map("check_in_at")
  checkOutAt     DateTime?        @map("check_out_at")
  lateMinutes    Int?             @map("late_minutes")
  reason         String?
  remarks        String?
  source         AttendanceSource @default(MANUAL)
  markedById     String?          @map("marked_by_id") @db.Uuid
  correctedById  String?          @map("corrected_by_id") @db.Uuid
  correctedAt    DateTime?        @map("corrected_at")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  organization Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  teacher      Teacher?               @relation(fields: [teacherId, organizationId], references: [id, organizationId], onDelete: Cascade)
  staff        Staff?                 @relation(fields: [staffId, organizationId], references: [id, organizationId], onDelete: Cascade)
  markedBy     User?                  @relation("EmployeeAttendanceMarkedBy", fields: [markedById], references: [id], onDelete: SetNull)
  corrections  AttendanceCorrection[]

  @@unique([teacherId, date])
  @@unique([staffId, date])
  @@unique([id, organizationId])
  @@index([organizationId, date, status])
  @@index([organizationId, employeeType, date])
  @@map("employee_attendance")
}

// Every change to a submitted record, applied or requested. The before and
// after values are kept, so corrections never overwrite history.
model AttendanceCorrection {
  id                   String                     @id @default(uuid()) @db.Uuid
  organizationId       String                     @map("organization_id") @db.Uuid
  // Exactly one of these (CHECK constraint).
  studentAttendanceId  String?                    @map("student_attendance_id") @db.Uuid
  employeeAttendanceId String?                    @map("employee_attendance_id") @db.Uuid
  fromStatus           AttendanceStatus           @map("from_status")
  toStatus             AttendanceStatus           @map("to_status")
  fromLateMinutes      Int?                       @map("from_late_minutes")
  toLateMinutes        Int?                       @map("to_late_minutes")
  fromReason           String?                    @map("from_reason")
  toReason             String?                    @map("to_reason")
  // Why the change is needed (required).
  justification        String
  status               AttendanceCorrectionStatus @default(PENDING)
  requestedById        String?                    @map("requested_by_id") @db.Uuid
  reviewedById         String?                    @map("reviewed_by_id") @db.Uuid
  reviewedAt           DateTime?                  @map("reviewed_at")
  reviewNote           String?                    @map("review_note")
  appliedAt            DateTime?                  @map("applied_at")
  createdAt            DateTime                   @default(now()) @map("created_at")

  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  studentAttendance  StudentAttendance?  @relation(fields: [studentAttendanceId, organizationId], references: [id, organizationId], onDelete: Cascade)
  employeeAttendance EmployeeAttendance? @relation(fields: [employeeAttendanceId, organizationId], references: [id, organizationId], onDelete: Cascade)
  requestedBy        User?               @relation("AttendanceCorrectionRequestedBy", fields: [requestedById], references: [id], onDelete: SetNull)
  reviewedBy         User?               @relation("AttendanceCorrectionReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)

  // At most one open request per record.
  @@unique([studentAttendanceId], map: "attendance_corrections_one_pending_student_key", where: raw("status = 'PENDING'"))
  @@unique([employeeAttendanceId], map: "attendance_corrections_one_pending_employee_key", where: raw("status = 'PENDING'"))
  @@index([organizationId, status, createdAt])
  @@index([studentAttendanceId])
  @@index([employeeAttendanceId])
  @@map("attendance_corrections")
}

// Shortage alerts already raised, so the same issue isn't announced again
// in the same month. Delivery goes through the guardian notification
// boundary (features/guardians/notifications.ts).
model AttendanceAlert {
  id                String              @id @default(uuid()) @db.Uuid
  organizationId    String              @map("organization_id") @db.Uuid
  studentId         String              @map("student_id") @db.Uuid
  academicYearId    String              @map("academic_year_id") @db.Uuid
  // "OVERALL" or "OFFERING:<id>".
  scope             String
  kind              AttendanceAlertKind
  // "YYYY-MM": one alert per issue per month.
  period            String
  percentage        Float
  guardiansNotified Int                 @default(0) @map("guardians_notified")
  createdById       String?             @map("created_by_id") @db.Uuid
  createdAt         DateTime            @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  student      Student      @relation(fields: [studentId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@unique([studentId, academicYearId, scope, kind, period])
  @@index([organizationId, createdAt])
  @@map("attendance_alerts")
}

// ============================================================ examinations
//
// Kept deliberately separate:
//   AssessmentType      what kind of assessment (organisation-defined names)
//   Examination         one assessment event in an academic year
//   ExaminationSubject  a subject offering assessed in that examination
//   AssessmentComponent theory, practical, internal, ... of that subject
//   MarksSheet          one subject (and section) worth of marks, carrying
//                       the draft → submitted → verified → approved workflow
//   StudentMark         one student's raw marks for one component
//   GradingScale        versioned bands that turn percentages into grades
//   ResultPolicy        pass/fail, absence, GPA, rounding and ranking rules
//   ResultPublication   a published, immutable version of an examination's
//                       results; StudentResult rows are its contents
// Calculation lives in features/exams/calculation.ts (pure, unit-tested)
// and is the only place grades, totals and GPA are computed. Published
// results keep the exact rules they were calculated with.

// Broad classification for filters and reports; names are the organisation's.
enum AssessmentCategory {
  CLASS_TEST
  UNIT_TEST
  TERMINAL
  MIDTERM
  FINAL
  PRACTICAL
  INTERNAL
  PROJECT
  SEMESTER
  MOCK
  OTHER
}

// DRAFT: being set up. SCHEDULED: configuration frozen, marks entry open.
// APPROVED: every marks sheet approved and the rules snapshotted. PUBLISHED:
// results released. REVISION: a correction is in progress after publication
// (the published version stays visible until a revised one is published).
// Ongoing/completed are shown from the dates, not stored.
enum ExaminationStatus {
  DRAFT
  SCHEDULED
  APPROVED
  PUBLISHED
  REVISION
  ARCHIVED
}

enum ComponentType {
  THEORY
  PRACTICAL
  INTERNAL
  PROJECT
  PRESENTATION
  VIVA
  LAB
  ASSIGNMENT
  OTHER
}

// LETTER: grades only. GRADE_POINT: grades with grade points (needed for
// GPA). PERCENTAGE_BAND: named percentage bands (Distinction, First, ...).
enum GradingType {
  LETTER
  GRADE_POINT
  PERCENTAGE_BAND
}

// Only drafts are edited; changing an active scale makes a new version.
enum GradingScaleStatus {
  DRAFT
  ACTIVE
  RETIRED
}

// How an absent component counts. RESULT_ABSENT: the subject result is
// "absent" (not passed). COUNT_AS_ZERO: zero marks, normal pass rules.
enum AbsentTreatment {
  RESULT_ABSENT
  COUNT_AS_ZERO
}

enum GpaMethod {
  NONE
  CREDIT_WEIGHTED
  SIMPLE_AVERAGE
}

// What decides a subject pass: pass marks, a non-failing grade, or both.
enum SubjectPassRule {
  MARKS
  GRADE
  MARKS_AND_GRADE
}

enum RankBasis {
  TOTAL
  PERCENTAGE
  GPA
}

enum RankScope {
  CLASS
  SECTION
}

// SHARED: 1, 1, 3. DENSE: 1, 1, 2.
enum RankTieMode {
  SHARED
  DENSE
}

// RETURNED behaves like DRAFT (editable) but records that a reviewer sent it back.
enum MarksSheetStatus {
  DRAFT
  SUBMITTED
  VERIFIED
  APPROVED
  RETURNED
}

// A component with no StudentMark row has not been entered; it is never
// treated as zero.
enum MarkStatus {
  SCORED
  ABSENT
  EXEMPT
  INCOMPLETE
  WITHHELD
}

enum ResultStatus {
  PASS
  FAIL
  ABSENT
  INCOMPLETE
  WITHHELD
  EXEMPT
  PENDING
}

enum PublicationStatus {
  ACTIVE
  SUPERSEDED
}

// "First Terminal", "Unit Test", "Semester Final", ... per organisation.
model AssessmentType {
  id             String             @id @default(uuid()) @db.Uuid
  organizationId String             @map("organization_id") @db.Uuid
  name           String
  code           String?
  category       AssessmentCategory @default(OTHER)
  description    String?
  isActive       Boolean            @default(true) @map("is_active")
  sortOrder      Int                @default(0) @map("sort_order")
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  examinations Examination[]

  @@unique([organizationId, name])
  @@unique([id, organizationId])
  @@map("assessment_types")
}

model GradingScale {
  id                String             @id @default(uuid()) @db.Uuid
  organizationId    String             @map("organization_id") @db.Uuid
  name              String
  code              String?
  description       String?
  gradingType       GradingType        @map("grading_type")
  status            GradingScaleStatus @default(DRAFT)
  isDefault         Boolean            @default(false) @map("is_default")
  version           Int                @default(1)
  previousVersionId String?            @map("previous_version_id") @db.Uuid
  effectiveFrom     DateTime?          @map("effective_from") @db.Date
  effectiveTo       DateTime?          @map("effective_to") @db.Date
  createdById       String?            @map("created_by_id") @db.Uuid
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")

  organization    Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  previousVersion GradingScale?      @relation("GradingScaleVersions", fields: [previousVersionId], references: [id], onDelete: SetNull)
  nextVersions    GradingScale[]     @relation("GradingScaleVersions")
  rules           GradingScaleRule[]
  policies        ResultPolicy[]
  examinations    Examination[]

  @@unique([organizationId, name, version])
  @@unique([id, organizationId])
  @@unique([organizationId], map: "grading_scales_one_default_key", where: raw("is_default"))
  @@index([organizationId, status])
  @@map("grading_scales")
}

// One band. minimum is inclusive and maximum exclusive, except a band ending
// at 100, which includes 100. Bands of a scale never overlap and cover 0–100.
model GradingScaleRule {
  id                String   @id @default(uuid()) @db.Uuid
  organizationId    String   @map("organization_id") @db.Uuid
  gradingScaleId    String   @map("grading_scale_id") @db.Uuid
  grade             String
  minimumPercentage Decimal  @map("minimum_percentage") @db.Decimal(5, 2)
  maximumPercentage Decimal  @map("maximum_percentage") @db.Decimal(5, 2)
  gradePoint        Decimal? @map("grade_point") @db.Decimal(4, 2)
  description       String?
  // A failing (non-graded) band such as "NG" or "E".
  isFailing         Boolean  @default(false) @map("is_failing")
  sequence          Int      @default(0)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  gradingScale GradingScale @relation(fields: [gradingScaleId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@unique([gradingScaleId, grade])
  @@index([gradingScaleId, sequence])
  @@map("grading_scale_rules")
}

// Result rules an organisation applies to an examination. Nothing here is a
// national default: administrators configure and verify their own policy.
model ResultPolicy {
  id                    String          @id @default(uuid()) @db.Uuid
  organizationId        String          @map("organization_id") @db.Uuid
  name                  String
  description           String?
  // Suggested for examinations of this level (null: any level).
  educationLevelId      String?         @map("education_level_id") @db.Uuid
  gradingScaleId        String?         @map("grading_scale_id") @db.Uuid
  isDefault             Boolean         @default(false) @map("is_default")
  isActive              Boolean         @default(true) @map("is_active")
  subjectPassRule       SubjectPassRule @default(MARKS) @map("subject_pass_rule")
  // Components with pass marks must each be passed (e.g. theory and practical separately).
  componentPassRequired Boolean         @default(false) @map("component_pass_required")
  absentTreatment       AbsentTreatment @default(RESULT_ABSENT) @map("absent_treatment")
  // Optional subjects the student took count towards totals and GPA.
  optionalInAggregate   Boolean         @default(false) @map("optional_in_aggregate")
  gpaMethod             GpaMethod       @default(NONE) @map("gpa_method")
  // Decimal places (half-up) for percentages and GPA, applied before grading.
  percentageDecimals    Int             @default(2) @map("percentage_decimals")
  gpaDecimals           Int             @default(2) @map("gpa_decimals")
  // Grace marks: up to this many marks in up to graceMaxSubjects subjects,
  // applied only when they make the student pass every compulsory subject.
  graceMarksPerSubject  Decimal?        @map("grace_marks_per_subject") @db.Decimal(5, 2)
  graceMaxSubjects      Int             @default(0) @map("grace_max_subjects")
  rankingEnabled        Boolean         @default(false) @map("ranking_enabled")
  rankBasis             RankBasis       @default(PERCENTAGE) @map("rank_basis")
  rankScope             RankScope       @default(SECTION) @map("rank_scope")
  rankTieMode           RankTieMode     @default(SHARED) @map("rank_tie_mode")
  // Workflow: a verification step before approval, and whether the person
  // who submitted marks may verify or approve them.
  requireVerification   Boolean         @default(true) @map("require_verification")
  separateReviewer      Boolean         @default(true) @map("separate_reviewer")
  createdAt             DateTime        @default(now()) @map("created_at")
  updatedAt             DateTime        @updatedAt @map("updated_at")

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  educationLevel EducationLevel? @relation(fields: [educationLevelId, organizationId], references: [id, organizationId], onDelete: NoAction)
  gradingScale   GradingScale?   @relation(fields: [gradingScaleId, organizationId], references: [id, organizationId], onDelete: NoAction)
  examinations   Examination[]

  @@unique([organizationId, name])
  @@unique([id, organizationId])
  @@unique([organizationId], map: "result_policies_one_default_key", where: raw("is_default"))
  @@map("result_policies")
}

model Examination {
  id                    String            @id @default(uuid()) @db.Uuid
  organizationId        String            @map("organization_id") @db.Uuid
  academicYearId        String            @map("academic_year_id") @db.Uuid
  assessmentTypeId      String            @map("assessment_type_id") @db.Uuid
  name                  String
  code                  String?
  description           String?
  // Optional scope for filters; the subjects decide which classes sit it.
  educationLevelId      String?           @map("education_level_id") @db.Uuid
  programId             String?           @map("program_id") @db.Uuid
  // Free text ("First term", "Semester 3"): terms aren't modelled separately.
  term                  String?
  startDate             DateTime          @map("start_date") @db.Date
  endDate               DateTime          @map("end_date") @db.Date
  resultPublicationDate DateTime?         @map("result_publication_date") @db.Date
  gradingScaleId        String            @map("grading_scale_id") @db.Uuid
  resultPolicyId        String            @map("result_policy_id") @db.Uuid
  status                ExaminationStatus @default(DRAFT)
  // Policy and grading scale as they were at first approval. Results are
  // always calculated (and revisions recalculated) from this snapshot, so
  // later edits to the policy or scale never change this examination.
  rulesSnapshot         Json?             @map("rules_snapshot")
  approvedAt            DateTime?         @map("approved_at")
  approvedById          String?           @map("approved_by_id") @db.Uuid
  publishedAt           DateTime?         @map("published_at")
  publishedById         String?           @map("published_by_id") @db.Uuid
  createdById           String?           @map("created_by_id") @db.Uuid
  archivedAt            DateTime?         @map("archived_at")
  createdAt             DateTime          @default(now()) @map("created_at")
  updatedAt             DateTime          @updatedAt @map("updated_at")

  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  academicYear   AcademicYear         @relation(fields: [academicYearId, organizationId], references: [id, organizationId], onDelete: NoAction)
  assessmentType AssessmentType       @relation(fields: [assessmentTypeId, organizationId], references: [id, organizationId], onDelete: NoAction)
  educationLevel EducationLevel?      @relation(fields: [educationLevelId, organizationId], references: [id, organizationId], onDelete: NoAction)
  program        Program?             @relation(fields: [programId, organizationId], references: [id, organizationId], onDelete: NoAction)
  gradingScale   GradingScale         @relation(fields: [gradingScaleId, organizationId], references: [id, organizationId], onDelete: NoAction)
  resultPolicy   ResultPolicy         @relation(fields: [resultPolicyId, organizationId], references: [id, organizationId], onDelete: NoAction)
  subjects       ExaminationSubject[]
  sheets         MarksSheet[]
  marks          StudentMark[]
  markHistory    StudentMarkHistory[]
  holds          ResultHold[]
  publications   ResultPublication[]

  @@unique([organizationId, academicYearId, name])
  @@unique([id, organizationId])
  @@index([organizationId, academicYearId, status])
  @@index([organizationId, startDate])
  @@index([organizationId, assessmentTypeId])
  @@map("examinations")
}

// A subject offering (subject × class × year) assessed in an examination.
// The class is copied from the offering so marks sheets can reference
// (subject, class) together and sections always belong to that class.
model ExaminationSubject {
  id                String    @id @default(uuid()) @db.Uuid
  organizationId    String    @map("organization_id") @db.Uuid
  examinationId     String    @map("examination_id") @db.Uuid
  subjectOfferingId String    @map("subject_offering_id") @db.Uuid
  classId           String    @map("class_id") @db.Uuid
  // Full marks of the subject. Without component weightage it equals the
  // sum of the components' full marks.
  maximumMarks      Decimal   @map("maximum_marks") @db.Decimal(7, 2)
  passMarks         Decimal?  @map("pass_marks") @db.Decimal(7, 2)
  // Copied from the offering/subject when added; null means no credits.
  creditHours       Decimal?  @map("credit_hours") @db.Decimal(5, 2)
  // Optional subjects apply only to students who have marks in them.
  isCompulsory      Boolean   @default(true) @map("is_compulsory")
  examDate          DateTime? @map("exam_date") @db.Date
  // "HH:MM" local times.
  startTime         String?   @map("start_time")
  endTime           String?   @map("end_time")
  venue             String?
  sequence          Int       @default(0)
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  organization    Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  examination     Examination           @relation(fields: [examinationId, organizationId], references: [id, organizationId], onDelete: Cascade)
  class           AcademicClass         @relation(fields: [classId, organizationId], references: [id, organizationId], onDelete: NoAction)
  subjectOffering SubjectOffering       @relation(fields: [subjectOfferingId, classId], references: [id, classId], onDelete: NoAction)
  components      AssessmentComponent[]
  sheets          MarksSheet[]
  remarks         MarkRemark[]

  @@unique([examinationId, subjectOfferingId])
  @@unique([id, organizationId])
  @@unique([id, examinationId, classId])
  @@index([organizationId, classId])
  @@map("examination_subjects")
}

// Theory, practical, internal, ... of one examination subject. A subject
// without separate parts has a single component.
model AssessmentComponent {
  id                   String        @id @default(uuid()) @db.Uuid
  organizationId       String        @map("organization_id") @db.Uuid
  examinationSubjectId String        @map("examination_subject_id") @db.Uuid
  name                 String
  componentType        ComponentType @default(THEORY) @map("component_type")
  maximumMarks         Decimal       @map("maximum_marks") @db.Decimal(7, 2)
  // Only enforced when the policy requires component passes.
  passMarks            Decimal?      @map("pass_marks") @db.Decimal(7, 2)
  // Percent of the subject; either every component of a subject has one
  // (summing to 100) or none does (raw marks are added up).
  weightage            Decimal?      @db.Decimal(5, 2)
  sequence             Int           @default(0)
  createdAt            DateTime      @default(now()) @map("created_at")
  updatedAt            DateTime      @updatedAt @map("updated_at")

  organization       Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  examinationSubject ExaminationSubject @relation(fields: [examinationSubjectId, organizationId], references: [id, organizationId], onDelete: Cascade)
  marks              StudentMark[]

  @@unique([examinationSubjectId, name])
  @@unique([id, organizationId])
  @@unique([id, examinationSubjectId])
  @@map("assessment_components")
}

// The marks of one examination subject for one section (or the whole class
// when it has no sections), and their review workflow. Created when marks
// are first saved. Marks can only be written while the sheet is DRAFT or
// RETURNED (enforced by a database trigger as well as the service).
model MarksSheet {
  id                   String           @id @default(uuid()) @db.Uuid
  organizationId       String           @map("organization_id") @db.Uuid
  examinationId        String           @map("examination_id") @db.Uuid
  examinationSubjectId String           @map("examination_subject_id") @db.Uuid
  classId              String           @map("class_id") @db.Uuid
  sectionId            String?          @map("section_id") @db.Uuid
  status               MarksSheetStatus @default(DRAFT)
  createdById          String?          @map("created_by_id") @db.Uuid
  // Set on the first submission: from then on every mark change is kept in
  // StudentMarkHistory with its reason.
  firstSubmittedAt     DateTime?        @map("first_submitted_at")
  submittedAt          DateTime?        @map("submitted_at")
  submittedById        String?          @map("submitted_by_id") @db.Uuid
  verifiedAt           DateTime?        @map("verified_at")
  verifiedById         String?          @map("verified_by_id") @db.Uuid
  approvedAt           DateTime?        @map("approved_at")
  approvedById         String?          @map("approved_by_id") @db.Uuid
  returnedAt           DateTime?        @map("returned_at")
  returnedById         String?          @map("returned_by_id") @db.Uuid
  returnNote           String?          @map("return_note")
  createdAt            DateTime         @default(now()) @map("created_at")
  updatedAt            DateTime         @updatedAt @map("updated_at")

  organization       Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  examination        Examination        @relation(fields: [examinationId, organizationId], references: [id, organizationId], onDelete: Cascade)
  examinationSubject ExaminationSubject @relation(fields: [examinationSubjectId, examinationId, classId], references: [id, examinationId, classId], onDelete: Cascade)
  section            Section?           @relation(fields: [sectionId, classId], references: [id, classId], onDelete: NoAction)
  marks              StudentMark[]

  @@unique([examinationSubjectId, sectionId], map: "marks_sheets_section_key", where: raw("section_id IS NOT NULL"))
  @@unique([examinationSubjectId], map: "marks_sheets_whole_class_key", where: raw("section_id IS NULL"))
  @@unique([id, organizationId])
  @@unique([id, examinationSubjectId])
  @@index([organizationId, examinationId, status])
  @@map("marks_sheets")
}

model StudentMark {
  id                   String     @id @default(uuid()) @db.Uuid
  organizationId       String     @map("organization_id") @db.Uuid
  examinationId        String     @map("examination_id") @db.Uuid
  examinationSubjectId String     @map("examination_subject_id") @db.Uuid
  componentId          String     @map("component_id") @db.Uuid
  marksSheetId         String     @map("marks_sheet_id") @db.Uuid
  studentId            String     @map("student_id") @db.Uuid
  enrollmentId         String     @map("enrollment_id") @db.Uuid
  status               MarkStatus
  // Raw marks; present exactly when status is SCORED (CHECK constraint).
  marksObtained        Decimal?   @map("marks_obtained") @db.Decimal(7, 2)
  enteredById          String?    @map("entered_by_id") @db.Uuid
  createdAt            DateTime   @default(now()) @map("created_at")
  updatedAt            DateTime   @updatedAt @map("updated_at")

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  examination  Examination         @relation(fields: [examinationId, organizationId], references: [id, organizationId], onDelete: Cascade)
  component    AssessmentComponent @relation(fields: [componentId, examinationSubjectId], references: [id, examinationSubjectId], onDelete: Cascade)
  sheet        MarksSheet          @relation(fields: [marksSheetId, examinationSubjectId], references: [id, examinationSubjectId], onDelete: Cascade)
  student      Student             @relation(fields: [studentId, organizationId], references: [id, organizationId], onDelete: Cascade)
  // The enrollment must be this student's.
  enrollment   Enrollment          @relation(fields: [enrollmentId, studentId], references: [id, studentId], onDelete: NoAction)

  // At most one mark per student per component.
  @@unique([componentId, studentId])
  @@index([organizationId, examinationId, studentId])
  @@index([marksSheetId])
  @@map("student_marks")
}

// Append-only: every change to a mark after its sheet was first submitted
// (returned sheets, post-publication corrections), with the reason.
model StudentMarkHistory {
  id             String      @id @default(uuid()) @db.Uuid
  organizationId String      @map("organization_id") @db.Uuid
  examinationId  String      @map("examination_id") @db.Uuid
  componentId    String      @map("component_id") @db.Uuid
  studentId      String      @map("student_id") @db.Uuid
  fromStatus     MarkStatus? @map("from_status")
  fromMarks      Decimal?    @map("from_marks") @db.Decimal(7, 2)
  toStatus       MarkStatus? @map("to_status")
  toMarks        Decimal?    @map("to_marks") @db.Decimal(7, 2)
  reason         String
  changedById    String?     @map("changed_by_id") @db.Uuid
  createdAt      DateTime    @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  examination  Examination  @relation(fields: [examinationId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@index([organizationId, examinationId, studentId])
  @@index([componentId, studentId])
  @@map("student_mark_history")
}

// Per student per examination subject: a remark shared on the report card
// and an internal examiner note that never leaves the staff screens.
model MarkRemark {
  id                   String   @id @default(uuid()) @db.Uuid
  organizationId       String   @map("organization_id") @db.Uuid
  examinationSubjectId String   @map("examination_subject_id") @db.Uuid
  studentId            String   @map("student_id") @db.Uuid
  remark               String?
  internalNote         String?  @map("internal_note")
  updatedById          String?  @map("updated_by_id") @db.Uuid
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  organization       Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  examinationSubject ExaminationSubject @relation(fields: [examinationSubjectId, organizationId], references: [id, organizationId], onDelete: Cascade)
  student            Student            @relation(fields: [studentId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@unique([examinationSubjectId, studentId])
  @@map("mark_remarks")
}

// A student's whole result held back (fees, disciplinary review, ...). The
// portals show "withheld" without marks while a hold is open.
model ResultHold {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  examinationId  String    @map("examination_id") @db.Uuid
  studentId      String    @map("student_id") @db.Uuid
  reason         String
  createdById    String?   @map("created_by_id") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at")
  releasedAt     DateTime? @map("released_at")
  releasedById   String?   @map("released_by_id") @db.Uuid

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  examination  Examination  @relation(fields: [examinationId, organizationId], references: [id, organizationId], onDelete: Cascade)
  student      Student      @relation(fields: [studentId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@unique([examinationId, studentId], map: "result_holds_one_open_key", where: raw("released_at IS NULL"))
  @@index([organizationId, examinationId])
  @@map("result_holds")
}

// A published version of an examination's results. Revisions add a new
// version and supersede the previous one; nothing published is rewritten.
model ResultPublication {
  id             String            @id @default(uuid()) @db.Uuid
  organizationId String            @map("organization_id") @db.Uuid
  examinationId  String            @map("examination_id") @db.Uuid
  version        Int
  status         PublicationStatus @default(ACTIVE)
  // Required for revisions.
  reason         String?
  rulesSnapshot  Json              @map("rules_snapshot")
  summary        Json
  publishedById  String?           @map("published_by_id") @db.Uuid
  publishedAt    DateTime          @default(now()) @map("published_at")
  supersededAt   DateTime?         @map("superseded_at")
  notifiedAt     DateTime?         @map("notified_at")

  organization   Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  examination    Examination            @relation(fields: [examinationId, organizationId], references: [id, organizationId], onDelete: Cascade)
  results        StudentResult[]
  subjectResults StudentSubjectResult[]

  @@unique([examinationId, version])
  @@unique([id, organizationId])
  @@unique([id, examinationId])
  @@unique([examinationId], map: "result_publications_one_active_key", where: raw("status = 'ACTIVE'"))
  @@map("result_publications")
}

// One student's published result. Immutable (a trigger refuses updates).
model StudentResult {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  publicationId  String       @map("publication_id") @db.Uuid
  examinationId  String       @map("examination_id") @db.Uuid
  studentId      String       @map("student_id") @db.Uuid
  enrollmentId   String       @map("enrollment_id") @db.Uuid
  academicYearId String       @map("academic_year_id") @db.Uuid
  classId        String       @map("class_id") @db.Uuid
  sectionId      String?      @map("section_id") @db.Uuid
  status         ResultStatus
  totalObtained  Decimal?     @map("total_obtained") @db.Decimal(9, 2)
  totalMaximum   Decimal?     @map("total_maximum") @db.Decimal(9, 2)
  percentage     Decimal?     @db.Decimal(7, 4)
  grade          String?
  gradePoint     Decimal?     @map("grade_point") @db.Decimal(4, 2)
  gpa            Decimal?     @db.Decimal(6, 4)
  rank           Int?
  // Full calculation breakdown (subjects, components, grace, remarks).
  breakdown      Json
  createdAt      DateTime     @default(now()) @map("created_at")

  organization Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  publication  ResultPublication      @relation(fields: [publicationId, examinationId], references: [id, examinationId], onDelete: Cascade)
  student      Student                @relation(fields: [studentId, organizationId], references: [id, organizationId], onDelete: Cascade)
  enrollment   Enrollment             @relation(fields: [enrollmentId, studentId], references: [id, studentId], onDelete: NoAction)
  subjects     StudentSubjectResult[]

  @@unique([publicationId, studentId])
  @@unique([id, publicationId])
  @@index([organizationId, studentId])
  @@index([organizationId, examinationId, classId, sectionId])
  @@index([organizationId, academicYearId, status])
  @@map("student_results")
}

// Per-subject rows of a published result, for database-side analytics.
model StudentSubjectResult {
  id                   String       @id @default(uuid()) @db.Uuid
  organizationId       String       @map("organization_id") @db.Uuid
  publicationId        String       @map("publication_id") @db.Uuid
  resultId             String       @map("result_id") @db.Uuid
  examinationSubjectId String       @map("examination_subject_id") @db.Uuid
  subjectId            String       @map("subject_id") @db.Uuid
  classId              String       @map("class_id") @db.Uuid
  sectionId            String?      @map("section_id") @db.Uuid
  isCompulsory         Boolean      @map("is_compulsory")
  status               ResultStatus
  obtained             Decimal?     @db.Decimal(9, 2)
  maximum              Decimal?     @db.Decimal(9, 2)
  percentage           Decimal?     @db.Decimal(7, 4)
  grade                String?
  gradePoint           Decimal?     @map("grade_point") @db.Decimal(4, 2)

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  publication  ResultPublication @relation(fields: [publicationId, organizationId], references: [id, organizationId], onDelete: Cascade)
  result       StudentResult     @relation(fields: [resultId, publicationId], references: [id, publicationId], onDelete: Cascade)

  @@unique([resultId, examinationSubjectId])
  @@index([organizationId, publicationId, subjectId])
  @@map("student_subject_results")
}
